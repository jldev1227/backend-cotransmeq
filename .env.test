# Entorno de la suite de tests. Se versiona a propósito: no hay ningún secreto
# real aquí, y sin él la suite no es reproducible ni en otra máquina ni en CI.
#
# Lo carga `vitest.config.ts` con override, así que manda sobre `.env` aunque
# ese apunte a producción. Esa es justo la garantía que se busca: que ejecutar
# los tests NUNCA dependa de qué haya en `.env` en ese momento.

# Apunta al contenedor de docker-compose.test.yml.
# El nombre de la base contiene "test", que es lo que `tests/guard-db.ts` exige
# para permitir los `deleteMany()` sin filtro. No lo cambies por uno sin "test":
# la suite abortará, y hace bien.
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/cotransmeq_test?schema=public"

# Secreto de pruebas, sin relación con el de producción. Los helpers de test
# firman tokens con este mismo valor (`tests/helpers/canvas-servicios.ts`), así
# que lo único que importa es que sea consistente dentro de la suite.
JWT_SECRET="test-secret-no-usar-fuera-de-la-suite"
JWT_EXPIRY="1d"

NODE_ENV="test"
PORT=4199

# Los tests de sockets levantan el servidor en un puerto efímero y conectan
# clientes reales desde el mismo proceso, así que el origen no está restringido.
SOCKET_CORS_ORIGINS="http://localhost:4199"

# En `enforce` el handshake sin token válido se rechaza. La suite prueba los dos
# modos explícitamente, sobreescribiendo esta variable en el propio test.
SOCKET_AUTH_MODE="enforce"

# Nada de correo ni de S3 real desde los tests. Si algún camino intenta usarlos,
# preferimos que falle de forma ruidosa a que mande un correo de verdad.
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="bucket-inexistente-de-test"

FRONTEND_URL="http://localhost:5174"

  id                           String    @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String    @db.Uuid
  /// Posición dentro del cierre. Es presentación, NO identidad.
  orden                        Int       @default(0)
  cliente                      String    @default("TRANSMERALDA") @db.VarChar(255)
  placa                        String    @db.VarChar(20)

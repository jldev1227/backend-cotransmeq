  updated_at        DateTime                @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?               @db.Timestamptz(6)

  facturado_por usuarios                   @relation("factura_liq_facturado_por", fields: [facturado_por_id], references: [id])
  anulado_por   usuarios?                  @relation("factura_liq_anulado_por", fields: [anulado_por_id], references: [id])
  items         factura_liquidacion_item[]


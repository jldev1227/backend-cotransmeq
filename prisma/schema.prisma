  usuario_id                   String?  @db.Uuid
  /// Obligatorio de facto al pasar a ANULADA (lo valida el service).
  motivo                       String?
  created_at                   DateTime @default(now()) @db.Timestamptz(6)

  liquidacion_tercero_final liquidacion_tercero_final @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuario                   usuarios?                 @relation("historial_estado_lt_final_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([liquidacion_tercero_final_id, created_at], map: "idx_hist_estado_lt_final_cierre")
  @@index([usuario_id], map: "idx_hist_estado_lt_final_usuario")
}

model liquidacion_tercero_envio {
  id             String    @id @default(uuid()) @db.Uuid
  /// CIERRE | INGRESO | OCASIONAL — de qué canvas salió el envío.
  tipo           String    @default("CIERRE") @db.VarChar(20)
  /// Solo para tipo CIERRE (FK al cierre final).
  cierre_id      String?   @db.Uuid
  /// Cabecera del periodo para INGRESO/OCASIONAL. Sin FK a propósito: el
  /// historial debe sobrevivir a que se borre el borrador del mes.
  origen_id      String?   @db.Uuid
  tercero_id     String?   @db.Uuid
  anio           Int
  mes            Int
  /// Placa del cierre, o la hoja (INGRESOS/ADICIONALES/OCASIONALES).
  placa          String    @db.VarChar(20)
  email_destino  String    @db.VarChar(255)
  asunto         String    @db.VarChar(500)
  /// Mensaje personalizado que escribió quien envió (texto plano).
  mensaje        String?
  /// Nombres y tamaños de los adjuntos: [{ filename, size, tipo }].
  adjuntos       Json      @default("[]") @db.JsonB
  /// PENDIENTE | ENVIANDO | ENVIADO | ERROR
  estado         String    @default("PENDIENTE") @db.VarChar(20)
  error          String?
  /// resend | smtp-contabilidad | smtp
  proveedor      String?   @db.VarChar(30)
  message_id     String?   @db.VarChar(255)
  es_prueba      Boolean   @default(false)
  /// Sin FK a usuarios a propósito: el log debe sobrevivir a bajas de
  /// usuario y el nombre se congela al momento del envío.
  enviado_por_id String?   @db.Uuid
  enviado_por    String?   @db.VarChar(255)
  enviado_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  cierre  liquidacion_tercero_final? @relation(fields: [cierre_id], references: [id], onDelete: Cascade)
  tercero terceros?                  @relation(fields: [tercero_id], references: [id], onDelete: SetNull)

  @@index([cierre_id])
  @@index([tipo, anio, mes])
  @@index([tercero_id])
  @@index([anio, mes])
  @@index([estado])
  @@index([enviado_at])
}


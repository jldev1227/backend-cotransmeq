  conductor conductores @relation(fields: [conductor_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([conductor_id])
}

/// Registro diario de actividad del conductor
model registro_dia_laboral {
  id                           String   @id @default(uuid()) @db.Uuid
  conductor_id                 String   @db.Uuid
  fecha                        DateTime @db.Date
  tipo                         String   @db.VarChar(50)
  hora_inicio                  String?  @db.VarChar(10)
  hora_fin                     String?  @db.VarChar(10)
  horas_conducidas             Decimal? @db.Decimal(4, 1)
  cliente_id                   String?  @db.Uuid
  cliente_nombre               String?  @db.VarChar(255)
  vehiculo_placa               String?  @db.VarChar(20)
  observaciones                String?  @db.Text
  /// Vehículo que estuvo en mantenimiento ese día. Obligatorio (a nivel de
  /// aplicación) cuando `tipo = MANTENIMIENTO`: sin placa el día no sirve para
  /// auditar la disponibilidad de la flota ni para cruzar con la orden de
  /// taller. Va en el padre y no en un segmento porque un día de
  /// mantenimiento no es un recorrido: no tiene cliente, horario ni horas
  /// conducidas, y los segmentos alimentan la liquidación.
  /// Nullable en la BD por los registros históricos anteriores a esta regla.
  mantenimiento_vehiculo_id    String?  @db.Uuid
  /// Snapshot de la placa al momento del registro: si el vehículo se da de
  /// baja o cambia de placa, el histórico debe seguir diciendo qué carro fue.
  mantenimiento_vehiculo_placa String?  @db.VarChar(20)
  created_at                   DateTime @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime @updatedAt @db.Timestamptz(6)

  conductor              conductores                     @relation(fields: [conductor_id], references: [id], onDelete: Cascade)
  mantenimiento_vehiculo vehiculos?                      @relation("mantenimiento_vehiculo", fields: [mantenimiento_vehiculo_id], references: [id], onDelete: SetNull)
  segmentos              registro_dia_laboral_segmento[]

  deleted_at DateTime?                   @db.Timestamptz(6)
  bonos      registro_dia_laboral_bono[]

  @@unique([conductor_id, fecha])
  @@index([conductor_id])
  @@index([fecha])
  @@index([mantenimiento_vehiculo_id])
  @@index([deleted_at])
}

/// Tramo/segmento de un día laborado (cambio de cliente/vehículo dentro del mismo día)
model registro_dia_laboral_segmento {
  id                   String   @id @default(uuid()) @db.Uuid
  registro_dia_id      String   @db.Uuid
  cliente_id           String?  @db.Uuid
  cliente_nombre       String?  @db.VarChar(255)
  vehiculo_id          String?  @db.Uuid
  vehiculo_placa       String   @db.VarChar(20)
  hora_inicio          String   @db.VarChar(10)
  hora_fin             String   @db.VarChar(10)
  /// Indica si la hora de inicio corresponde al día SIGUIENTE
  /// (caso típico: turno que arranca pasada la medianoche).
  inicio_dia_siguiente Boolean  @default(false)
  /// Indica si la hora de fin corresponde al día SIGUIENTE
  /// (caso típico: turno que termina pasada la medianoche → +1).
  fin_dia_siguiente    Boolean  @default(false)
  horas_conducidas     Decimal  @default(0) @db.Decimal(4, 1)
  km_inicial           Int?
  km_final             Int?
  pernocte             Boolean  @default(false)
  orden                Int      @default(1)
  observaciones        String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)

  registro_dia registro_dia_laboral @relation(fields: [registro_dia_id], references: [id], onDelete: Cascade)
  cliente      clientes?            @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  vehiculo     vehiculos?           @relation(fields: [vehiculo_id], references: [id], onDelete: SetNull)

  deleted_at DateTime?                   @db.Timestamptz(6)
  bonos      registro_dia_laboral_bono[]

  @@index([registro_dia_id])
  @@index([cliente_id])
  @@index([vehiculo_id])
  @@index([registro_dia_id, orden])
  @@index([deleted_at])
}


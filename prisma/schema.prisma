model liquidacion_tercero_final_concepto {
  id                           String                                 @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String                                 @db.Uuid
  tipo                         String                                 @db.VarChar(50)
  concepto                     String                                 @db.VarChar(100)
  conductor_id                 String?                                @db.Uuid
  dias                         Decimal?                               @db.Decimal(10, 2)
  valor_unitario               Decimal                                @default(0) @db.Decimal(12, 2)
  porcentaje                   Decimal?                               @db.Decimal(8, 4)
  valor_total                  Decimal                                @default(0) @db.Decimal(12, 2)
  base_calculo                 Decimal?                               @db.Decimal(12, 2)
  calculado                    Boolean                                @default(false)
  observaciones                String?
  /// Cuando el cierre es multi-propietario, esta FK agrupa cada fila de
  /// impuesto al copropietario que la paga. NULL cuando el cierre es de un
  /// solo propietario (legacy / single-propietario).
  propietario_id               String?                                @db.Uuid
  orden                        Int                                    @default(0)
  /// Concurrencia optimista para la edición por celda del canvas de cierres
  /// finales. El UPDATE exige `WHERE version = base_version`; 0 filas
  /// afectadas significa que otro usuario escribió antes.
  version                      Int                                    @default(1)
  created_at                   DateTime                               @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                               @updatedAt @db.Timestamptz(6)
  deleted_at                   DateTime?                              @db.Timestamptz(6)
  liquidacion_tercero_final    liquidacion_tercero_final              @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  conductor                    conductores?                           @relation(fields: [conductor_id], references: [id], onDelete: SetNull)
  propietario                  liquidacion_tercero_final_propietario? @relation(fields: [propietario_id], references: [id], onDelete: Cascade)

  @@index([liquidacion_tercero_final_id])
  @@index([conductor_id])
  @@index([tipo])
  @@index([concepto])
  @@index([propietario_id])
}

model liquidacion_tercero_final_propietario {
  id                           String                               @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String                               @db.Uuid
  tercero_id                   String?                              @db.Uuid
  nombre                       String                               @db.VarChar(255)
  identificacion               String?                              @db.VarChar(50)
  /// Porcentaje (0–9999.9999%) del valor a pagar que le corresponde.
  porcentaje                   Decimal                              @db.Decimal(8, 4)
  /// Porcentaje efectivo de la cascada por orden: el propietario con menor
  /// `orden` toma su `porcentaje` del total; los demás reparten el remanente
  /// (100 − p1) proporcionalmente a sus `porcentaje` declarados.
  /// Ej. 15/50/50 → 15/42.5/42.5. NULL = pendiente de recálculo (se resuelve
  /// en memoria al serializar y se persiste al guardar/recalcular).
  porcentaje_efectivo          Decimal?                             @db.Decimal(8, 4)
  /// Concepto/nota de pago libre del copropietario, ej.
  /// "ABONAR A CRÉDITO BANCOOMEVA". Se muestra junto a su valor en la hoja.
  nota                         String?                              @db.VarChar(255)
  /// Si al copropietario se le calculan retenciones sobre su valor a
  /// facturar. FALSE para pagos internos por concepto (ej. abono a crédito):
  /// no generan egreso real y no tributan.
  aplica_retenciones           Boolean                              @default(true)
  orden                        Int                                  @default(0)
  created_at                   DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                             @updatedAt @db.Timestamptz(6)
  deleted_at                   DateTime?                            @db.Timestamptz(6)
  liquidacion_tercero_final    liquidacion_tercero_final            @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  tercero                      terceros?                            @relation(fields: [tercero_id], references: [id], onDelete: SetNull)
  conceptos                    liquidacion_tercero_final_concepto[]

  @@index([liquidacion_tercero_final_id])
  @@index([tercero_id])
  @@index([deleted_at])
}

model liquidacion_tercero_final_snapshot {
  id                           String   @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String   @db.Uuid
  /// Rama lógica. "main" = estado vigente. Cualquier otra rama representa
  /// un snapshot histórico no vigente.
  rama                         String   @default("main") @db.VarChar(60)
  /// Auto-incremental por liquidación. version=1 es la más antigua.
  version                      Int
  /// "manual" (cambio explícito), "auto" (cron horario), "revert"
  /// (al revertir a un snapshot anterior se genera uno nuevo).
  origen                       String   @default("manual") @db.VarChar(20)
  /// Referencia al snapshot desde el que se revirtió (cuando origen=revert).
  revertido_de_id              String?  @db.Uuid
  /// ID del usuario que originó el snapshot. null solo en "auto" del cron.
  usuario_id                   String?  @db.Uuid
  /// Snapshot completo: cabecera + totales + items pivote + conceptos + adicionales.
  payload                      Json     @db.JsonB
  /// Resumen de cambios respecto a la versión anterior.
  diff                         Json?    @db.JsonB
  created_at                   DateTime @default(now()) @db.Timestamptz(6)

  liquidacion_tercero_final liquidacion_tercero_final            @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuario                   usuarios?                            @relation("snapshot_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  revertido_de              liquidacion_tercero_final_snapshot?  @relation("snapshot_revertido_de", fields: [revertido_de_id], references: [id], onDelete: SetNull)
  revertidos                liquidacion_tercero_final_snapshot[] @relation("snapshot_revertido_de")

  @@unique([liquidacion_tercero_final_id, version])
  @@index([liquidacion_tercero_final_id, rama])
  @@index([created_at])
  @@index([usuario_id])
}


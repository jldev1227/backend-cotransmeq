  diff            Json?    @db.JsonB
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  usuario      usuarios?                                        @relation("snapshot_adicional_periodo_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)

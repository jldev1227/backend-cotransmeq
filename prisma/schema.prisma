  liquidacion_origen_id      String                     @db.Uuid
  placa                      String                     @db.VarChar(20)
  mes                        Int
  anio                       Int
  descripcion_cifrada        String                     @db.Text
  descripcion_nonce          String                     @db.VarChar(24)
  monto                      Decimal?                   @db.Decimal(12, 2)
  moneda                     String                     @default("COP") @db.VarChar(3)
  estado                     String                     @default("PENDIENTE") @db.VarChar(20)
  prioridad                  String                     @default("MEDIA") @db.VarChar(10)
  creado_por_usuario_id      String                     @db.Uuid
  aplicado_en_liquidacion_id String?                    @db.Uuid
  aplica_en                  DateTime?                  @db.Timestamptz(6)
  deleted_at                 DateTime?                  @db.Timestamptz(6)
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                   @updatedAt @db.Timestamptz(6)
  liquidacion_origen         liquidacion_tercero_final  @relation("recordatorio_origen", fields: [liquidacion_origen_id], references: [id], onDelete: Cascade)
  creado_por                 usuarios                   @relation("recordatorio_creado_por", fields: [creado_por_usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aplicado_en_liquidacion    liquidacion_tercero_final? @relation("recordatorio_aplicado", fields: [aplicado_en_liquidacion_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([placa, mes, anio])
  @@index([estado])
  @@index([creado_por_usuario_id])
  @@index([liquidacion_origen_id])
  @@index([aplicado_en_liquidacion_id])

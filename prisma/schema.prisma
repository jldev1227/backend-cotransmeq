/// Mensajes del chat de liquidaciones de terceros.
/// El contenido se cifra en AES-256-GCM con key derivada por liquidación.
model liquidacion_chat_mensaje {
  id                     String                    @id @default(uuid()) @db.Uuid
  liquidacion_tercero_id String                    @db.Uuid
  usuario_id             String                    @db.Uuid
  contenido_cifrado      String                    @db.Text
  nonce                  String                    @db.VarChar(24)
  tipo                   String                    @default("NOTA") @db.VarChar(20)
  recordatorio_id        String?                   @db.Uuid
  deleted_at             DateTime?                 @db.Timestamptz(6)
  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                  @updatedAt @db.Timestamptz(6)
  liquidacion_tercero    liquidacion_tercero_final @relation(fields: [liquidacion_tercero_id], references: [id], onDelete: Cascade)
  usuario                usuarios                  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([liquidacion_tercero_id])
  @@index([usuario_id])
  @@index([tipo])
  @@index([created_at])
}

/// Recordatorios planificados para liquidaciones futuras de una placa.

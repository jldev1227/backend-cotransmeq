model acciones_correctivas_preventivas {
  id                             String    @id @default(uuid()) @db.Uuid
  accion_numero                  String    @unique @db.VarChar(50)
  lugar_sede                     String?   @db.VarChar(255)
  proceso_origen_hallazgo        String?   @db.VarChar(255)
  componente_elemento_referencia String?   @db.Text
  fuente_genero_hallazgo         String?   @db.Text
  marco_legal_normativo          String?   @db.Text
  fecha_identificacion_hallazgo  DateTime? @db.Date
  descripcion_hallazgo           String?   @db.Text
  tipo_hallazgo_detectado        String?   @db.VarChar(100)
  variable_categoria_analisis    String?   @db.VarChar(255)
  correccion_solucion_inmediata  String?   @db.Text
  fecha_implementacion           DateTime? @db.Date
  valoracion_riesgo              String?   @db.VarChar(50) // ALTO, MEDIO, BAJO
  requiere_actualizar_matriz     Boolean?  @default(false)
  tipo_accion_ejecutar           String?   @db.VarChar(100) // CORRECTIVA, PREVENTIVA, MEJORA

  // Evaluación de Eficacia (campos generales)
  fecha_evaluacion_eficacia    DateTime? @db.Date
  criterio_evaluacion_eficacia String?   @db.Text
  analisis_evidencias_cierre   String?   @db.Text
  evaluacion_cierre_eficaz     String?   @db.VarChar(50) // EFICAZ, NO EFICAZ
  soporte_cierre_eficaz        String?   @db.Text
  fecha_cierre_definitivo      DateTime? @db.Date
  responsable_cierre           String?   @db.VarChar(255)

  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  creado_por_id String?  @db.Uuid

  usuarios usuarios?                  @relation(fields: [creado_por_id], references: [id])
  causas   causas_accion_correctiva[]

  fuente_genero_hallazgo_otros     String?                             @db.VarChar(255)
  tipo_hallazgo_otros              String?                             @db.VarChar(255)
  hallazgo_tipo                    HallazgoTipo?
  aplica_correccion_inmediata      Boolean?                            @default(true)
  justificacion_no_correccion      String?
  responsable_correccion           String?                             @db.VarChar(255)
  registrado_por_id                String?                             @db.Uuid
  fecha_limite_cierre_accion       DateTime?                           @db.Date
  responsable_ejecucion            String?                             @db.VarChar(255)
  fecha_seguimiento                DateTime?                           @db.Date
  estado_accion                    String?                             @db.VarChar(100)
  estado_global                    ActionStatusGlobal                  @default(EN_PROCESO)
  estado_aprobacion                String?                             @default("PENDIENTE") @db.VarChar(20)
  fecha_actualizacion_estado       DateTime?                           @db.Date
  observaciones                    String?
  matriz_a_actualizar              String?                             @db.VarChar(255)
  fecha_limite_evaluacion_eficacia DateTime?                           @db.Date
  cargo_responsable_cierre         String?                             @db.VarChar(255)
  observaciones_cierre             String?
  evaluaciones_eficacia            Json?
  aplica_reapertura                Boolean?                            @default(false)
  fecha_reapertura                 DateTime?                           @db.Date
  razon_reapertura                 String?
  accion_origen_reapertura         String?                             @db.VarChar(50)
  deleted_at                       DateTime?                           @db.Timestamptz(6)
  registrado_por                   usuarios?                           @relation("acciones_estado_registrado", fields: [registrado_por_id], references: [id])
  seguimientos_correccion          seguimientos_correccion_inmediata[]
  ciclos_eficacia                  ciclos_seguimiento_eficacia[]
  evidencias_eficacia              evidencias_eficacia_cierre[]
  aprobaciones                     aprobaciones_accion[]

  // ── PESV ─ vínculo con el ciclo y el paso que originó el hallazgo.
  /// `origen_pesv` distingue los hallazgos de la auditoría PESV del resto: el
  /// indicador NCAC solo cuenta esos, no todas las acciones de la empresa.
  pesv_cycle_id    String?         @db.Uuid
  pesv_step_number Int?
  origen_pesv      Boolean         @default(false)
  pesv_ciclo       pesv_cycle?     @relation(fields: [pesv_cycle_id], references: [id], onDelete: SetNull)
  pesv_siniestros  pesv_incident[] @relation("pesv_siniestro_accion")

  @@index([accion_numero])
  @@index([tipo_accion_ejecutar])
  @@index([fecha_identificacion_hallazgo])
  @@index([estado_global])
  @@index([hallazgo_tipo])
  @@index([deleted_at])
}

model causas_accion_correctiva {
  id                          String    @id @default(uuid()) @db.Uuid
  accion_correctiva_id        String    @db.Uuid
  orden                       Int // 1, 2, 3, 4, 5 (para 1° Por qué, 2° Por qué, etc.)
  analisis_causa              String    @db.Text // ¿Por qué ocurrió?
  descripcion_plan_accion     String?   @db.Text // Plan para eliminar esta causa
  fecha_limite_implementacion DateTime? @db.Date
  responsable_ejecucion       String?   @db.VarChar(255)
  fecha_seguimiento           DateTime? @db.Date
  estado_seguimiento          String?   @db.VarChar(50) // "En Proceso", "Cumplida", "Vencida"
  descripcion_observaciones   String?   @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  accion_correctiva acciones_correctivas_preventivas @relation(fields: [accion_correctiva_id], references: [id], onDelete: Cascade)

  es_causa_raiz                Boolean?             @default(false)
  fecha_evaluacion_eficacia    DateTime?            @db.Date
  criterio_evaluacion_eficacia String?
  analisis_evidencias_cierre   String?
  evaluacion_cierre_eficaz     String?              @db.VarChar(50)
  soporte_cierre_eficaz        String?
  fecha_cierre                 DateTime?            @db.Date
  responsable_cierre           String?              @db.VarChar(255)
  sugerencia_ia                Json?
  seguimientos                 seguimientos_causa[]

  @@unique([accion_correctiva_id, orden])
  @@index([accion_correctiva_id])
  @@index([estado_seguimiento])
  @@index([evaluacion_cierre_eficaz])
  @@index([fecha_cierre])
  @@index([estado_seguimiento], map: "idx_causas_estado_seguimiento")
}


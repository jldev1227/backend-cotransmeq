generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evaluacion {
  id             String      @id @default(uuid()) @db.Uuid
  titulo         String
  descripcion    String?
  requiere_firma Boolean     @default(false)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?   @db.Timestamptz(6)
  preguntas      Pregunta[]
  resultados     Resultado[]
}

model Pregunta {
  id                String           @id @default(uuid()) @db.Uuid
  evaluacionId      String           @db.Uuid
  texto             String
  tipo              TipoPreguntaEnum
  puntaje           Int
  relacionIzq       String[]
  relacionDer       String[]
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  respuestaCorrecta Float?
  opciones          Opcion[]
  evaluacion        Evaluacion       @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  respuestas        Respuesta[]
}

model Opcion {
  id         String   @id @default(uuid()) @db.Uuid
  preguntaId String   @db.Uuid
  texto      String
  esCorrecta Boolean  @default(false)
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
}

model Resultado {
  id                 String      @id @default(uuid()) @db.Uuid
  evaluacionId       String      @db.Uuid
  nombre_completo    String
  numero_documento   String
  cargo              String
  correo             String
  telefono           String
  puntaje_total      Int
  firma              String?
  ip_address         String?     @db.VarChar(45)
  user_agent         String?
  device_fingerprint String?     @db.VarChar(255)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  respuestas         Respuesta[]
  evaluacion         Evaluacion  @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
}

model Respuesta {
  id           String    @id @default(uuid()) @db.Uuid
  resultadoId  String    @db.Uuid
  preguntaId   String    @db.Uuid
  valor_texto  String?
  valor_numero Float?
  opcionesIds  String[]
  relacion     Json?
  puntaje      Int
  pregunta     Pregunta  @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  resultado    Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade)
}

model SequelizeMeta {
  name String @id @db.VarChar(255)
}

model anticipos {
  valor          Decimal        @db.Decimal(10, 2)
  fecha          DateTime       @db.Date
  concepto       String?        @db.VarChar(255)
  created_at     DateTime       @db.Timestamptz(6)
  updated_at     DateTime       @db.Timestamptz(6)
  id             String         @id @db.Uuid
  liquidacion_id String?        @db.Uuid
  conductor_id   String?        @db.Uuid
  creado_por_id  String?        @db.Uuid
  conductores    conductores?   @relation(fields: [conductor_id], references: [id])
  usuarios       usuarios?      @relation(fields: [creado_por_id], references: [id])
  liquidaciones  liquidaciones? @relation(fields: [liquidacion_id], references: [id])
}

model bonificaciones {
  name           String         @db.VarChar(255)
  values         String         @default("[]")
  value          Decimal        @db.Decimal(10, 2)
  created_at     DateTime       @db.Timestamptz(6)
  old_id         Int?
  updated_at     DateTime       @db.Timestamptz(6)
  id             String         @id @db.Uuid
  liquidacion_id String?        @db.Uuid
  vehiculo_id    String?        @db.Uuid
  creado_por_id  String?        @db.Uuid
  usuarios       usuarios?      @relation(fields: [creado_por_id], references: [id])
  liquidaciones  liquidaciones? @relation(fields: [liquidacion_id], references: [id])
  vehiculos      vehiculos?     @relation(fields: [vehiculo_id], references: [id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model conductores {
  nombre                                 String                                   @db.VarChar(255)
  apellido                               String                                   @db.VarChar(255)
  tipo_identificacion                    String                                   @db.VarChar(255)
  numero_identificacion                  String?                                  @unique @db.VarChar(255)
  email                                  String?                                  @unique @db.VarChar(255)
  telefono                               String?                                  @db.VarChar(255)
  fecha_nacimiento                       DateTime?                                @db.Date
  genero                                 String?                                  @db.VarChar(255)
  direccion                              String?                                  @db.VarChar(255)
  fecha_ingreso                          DateTime?                                @db.Date
  salario_base                           Decimal?                                 @db.Decimal(10, 2)
  eps                                    String?                                  @db.VarChar(255)
  fondo_pension                          String?                                  @db.VarChar(255)
  arl                                    String?                                  @db.VarChar(255)
  termino_contrato                       String?
  fecha_terminacion                      String?
  licencia_conduccion                    Json?
  ultimo_acceso                          DateTime?                                @db.Timestamptz(6)
  permisos                               Json?                                    @default("{\"verViajes\": true, \"verDocumentos\": true, \"actualizarPerfil\": true, \"verMantenimientos\": true}")
  cargo                                  String                                   @default("CONDUCTOR") @db.VarChar(255)
  categoria_licencia                     String?                                  @db.VarChar(255)
  created_at                             DateTime                                 @db.Timestamptz(6)
  foto_url                               String?                                  @db.VarChar(255)
  password                               String?                                  @db.VarChar(255)
  tipo_contrato                          String?                                  @db.VarChar(255)
  updated_at                             DateTime                                 @db.Timestamptz(6)
  vencimiento_licencia                   DateTime?                                @db.Date
  id                                     String                                   @id @db.Uuid
  estado                                 enum_conductores_estado                  @default(activo)
  sede_trabajo                           enum_conductores_sede_trabajo?
  tipo_sangre                            tipo_sangre_enum?
  creado_por_id                          String?                                  @db.Uuid
  actualizado_por_id                     String?                                  @db.Uuid
  oculto                                 Boolean                                  @default(false)
  deleted_at                             DateTime?                                @db.Timestamptz(6)
  nomina                                 Boolean                                  @default(false)
  anticipos                              anticipos[]
  conductor_tokens                       conductor_token[]
  usuarios                               usuarios?                                @relation(fields: [creado_por_id], references: [id])
  documentos_compartidos                 documentos_compartidos[]
  excesos_velocidad                      excesos_velocidad[]
  firmas_desprendibles                   firmas_desprendibles[]
  firmas_primas                          firmas_primas[]
  liquidaciones                          liquidaciones[]
  primas                                 primas[]
  preoperacionales                       preoperacionales[]
  recargos_planillas                     recargos_planillas[]
  registros_dia_laboral                  registro_dia_laboral[]
  salidas_no_conformes                   salidas_no_conformes[]
  servicio                               servicio[]
  vehiculos                              vehiculos[]
  liquidacion_tercero_concepto           liquidacion_tercero_concepto[]
  liquidacion_tercero_final_concepto     liquidacion_tercero_final_concepto[]
  liquidacion_tercero_ocasional_concepto liquidacion_tercero_ocasional_concepto[] @relation("ocasional_concepto_conductor")
  form_assignment_targets                form_assignment_target[]                 @relation("form_assignment_target_conductor")
  form_submissions                       form_submission[]                        @relation("form_submission_conductor")
}

/// Tokens de acceso para conductores (magic link por email)
model conductor_token {
  id           String      @id @default(uuid()) @db.Uuid
  conductor_id String      @db.Uuid
  token        String      @unique @db.VarChar(512)
  expires_at   DateTime    @db.Timestamptz(6)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  used         Boolean     @default(false)
  conductor    conductores @relation(fields: [conductor_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([conductor_id])
}

/// Registro diario de actividad del conductor
/// SOLO metadata global: tipo, fecha, observaciones.
/// Los detalles (cliente, vehículo, horarios, horas) viven en registro_dia_laboral_segmento.
model registro_dia_laboral {
  id            String                          @id @default(uuid()) @db.Uuid
  conductor_id  String                          @db.Uuid
  fecha         DateTime                        @db.Date
  tipo          String                          @db.VarChar(50)
  observaciones String?
  /// Vehículo que estuvo en mantenimiento ese día. Obligatorio (a nivel de
  /// aplicación) cuando `tipo = MANTENIMIENTO`: sin placa el día no sirve para
  /// auditar la disponibilidad de la flota ni para cruzar con la orden de
  /// taller. Va en el padre y no en un segmento porque un día de
  /// mantenimiento no es un recorrido: no tiene cliente, horario ni horas
  /// conducidas, y los segmentos alimentan la liquidación.
  /// Nullable en la BD por los registros históricos anteriores a esta regla.
  mantenimiento_vehiculo_id    String?    @db.Uuid
  /// Snapshot de la placa al momento del registro: si el vehículo se da de
  /// baja o cambia de placa, el histórico debe seguir diciendo qué carro fue.
  mantenimiento_vehiculo_placa String?    @db.VarChar(20)
  deleted_at    DateTime?                       @db.Timestamptz(6)
  created_at    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                        @updatedAt @db.Timestamptz(6)
  conductor     conductores                     @relation(fields: [conductor_id], references: [id], onDelete: Cascade)
  mantenimiento_vehiculo vehiculos?             @relation("mantenimiento_vehiculo", fields: [mantenimiento_vehiculo_id], references: [id], onDelete: SetNull)
  segmentos     registro_dia_laboral_segmento[]
  bonos         registro_dia_laboral_bono[]

  @@unique([conductor_id, fecha])
  @@index([conductor_id])
  @@index([fecha])
  @@index([deleted_at])
  @@index([mantenimiento_vehiculo_id])
}

/// Segmentos (tramos) de un día laborado: cada cambio de cliente/vehículo.
/// `vehiculo_placa` y los horarios son opcionales para soportar días
/// DISPONIBLE / DESCANSO / MANTENIMIENTO que no requieren vehículo
/// ni horas de conducción específicas.
model registro_dia_laboral_segmento {
  id                   String                      @id @default(uuid()) @db.Uuid
  registro_dia_id      String                      @db.Uuid
  cliente_id           String?                     @db.Uuid
  cliente_nombre       String?                     @db.VarChar(255)
  vehiculo_id          String?                     @db.Uuid
  vehiculo_placa       String?                     @db.VarChar(20)
  hora_inicio          String?                     @db.VarChar(10)
  hora_fin             String?                     @db.VarChar(10)
  /// Indica si la hora de inicio corresponde al día SIGUIENTE
  /// (caso típico: turno que arranca pasada la medianoche).
  inicio_dia_siguiente Boolean                     @default(false)
  /// Indica si la hora de fin corresponde al día SIGUIENTE
  /// (caso típico: turno que termina pasada la medianoche → +1).
  fin_dia_siguiente    Boolean                     @default(false)
  horas_conducidas     Decimal                     @default(0) @db.Decimal(4, 1)
  km_inicial           Int?
  km_final             Int?
  pernocte             Boolean                     @default(false)
  orden                Int                         @default(1)
  observaciones        String?
  deleted_at           DateTime?                   @db.Timestamptz(6)
  created_at           DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                    @updatedAt @db.Timestamptz(6)
  registro_dia         registro_dia_laboral        @relation(fields: [registro_dia_id], references: [id], onDelete: Cascade)
  cliente              clientes?                   @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  vehiculo             vehiculos?                  @relation(fields: [vehiculo_id], references: [id], onDelete: SetNull)
  bonos                registro_dia_laboral_bono[]

  @@index([registro_dia_id])
  @@index([cliente_id])
  @@index([vehiculo_id])
  @@index([registro_dia_id, orden])
  @@index([deleted_at])
}

/// Bonos otorgados a un recorrido (tramo) o a un día laborado completo.
/// Cada bono es una referencia a una `configuraciones_liquidacion` activa
/// (FK), lo que permite que el valor monetario se obtenga siempre de la
/// configuración vigente (lectura en vivo). El campo `valor` aquí se
/// conserva únicamente como snapshot informativo al momento de crear el
/// bono; NO es la fuente de cálculo.
///
/// Solo usuarios con el permiso individual `bonos-planilla` pueden
/// crear/eliminar.
model registro_dia_laboral_bono {
  id                    String                         @id @default(uuid()) @db.Uuid
  registro_dia_id       String                         @db.Uuid
  segmento_id           String?                        @db.Uuid
  config_liquidacion_id String                         @db.Uuid
  valor                 Decimal?                       @db.Decimal(10, 2)
  creado_por_id         String?                        @db.Uuid
  observaciones         String?
  created_at            DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                       @updatedAt @db.Timestamptz(6)
  registro_dia          registro_dia_laboral           @relation(fields: [registro_dia_id], references: [id], onDelete: Cascade)
  segmento              registro_dia_laboral_segmento? @relation(fields: [segmento_id], references: [id], onDelete: Cascade)
  config_liquidacion    configuraciones_liquidacion    @relation(fields: [config_liquidacion_id], references: [id], onDelete: Restrict)
  creado_por            usuarios?                      @relation("bonos_creados_por", fields: [creado_por_id], references: [id], onDelete: SetNull)

  @@index([registro_dia_id])
  @@index([segmento_id])
  @@index([config_liquidacion_id])
  @@index([creado_por_id])
}

model configuracion_liquidador {
  id                                                       String    @id @db.Uuid
  nombre                                                   String    @db.VarChar(255)
  valor                                                    Int
  descripcion                                              String?   @db.VarChar(255)
  activo                                                   Boolean?  @default(true)
  created_at                                               DateTime  @db.Timestamptz(6)
  updated_at                                               DateTime  @db.Timestamptz(6)
  creado_por_id                                            String?   @db.Uuid
  actualizado_por_id                                       String?   @db.Uuid
  users_configuracion_liquidador_actualizado_por_idTousers usuarios? @relation("configuracion_liquidador_actualizado_por_idTousers", fields: [actualizado_por_id], references: [id])
  users_configuracion_liquidador_creado_por_idTousers      usuarios? @relation("configuracion_liquidador_creado_por_idTousers", fields: [creado_por_id], references: [id])
}

model configuraciones_liquidacion {
  id         String                                @id @db.Uuid
  nombre     String                                @db.VarChar(255)
  valor      Decimal                               @db.Decimal(10, 2)
  tipo       enum_configuraciones_liquidacion_tipo @default(VALOR_NUMERICO)
  activo     Boolean                               @default(true)
  created_at DateTime                              @db.Timestamptz(6)
  updated_at DateTime                              @db.Timestamptz(6)
  deleted_at DateTime?                             @db.Timestamptz(6)
  anio       Int?                                  @default(2025)
  bonos      registro_dia_laboral_bono[]
  visual     bono_config_visual[]
}

/// Tabla pivote: indica qué `configuraciones_liquidacion` se exponen
/// como columna de bonos en la pestaña de Recorridos. La decisión es
/// GLOBAL (compartida por todos los usuarios) y segmentada por AÑO.
///
///   - Si existe un registro con `visible = true`  → se pinta la columna.
///   - Si existe un registro con `visible = false` → NO se pinta.
///   - Si NO existe registro para una config activa → DEFAULT true
///     (se asume visible hasta que alguien la oculte explícitamente).
///
/// El frontend ofrece un modal de configuración para alternar este
/// flag sin tocar la config de liquidación en sí.
model bono_config_visual {
  id                    String                      @id @default(uuid()) @db.Uuid
  config_liquidacion_id String                      @db.Uuid
  anio                  Int
  visible               Boolean                     @default(true)
  creado_por_id         String?                     @db.Uuid
  created_at            DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                    @updatedAt @db.Timestamptz(6)
  config_liquidacion    configuraciones_liquidacion @relation(fields: [config_liquidacion_id], references: [id], onDelete: Cascade)
  creado_por            usuarios?                   @relation("bono_config_visual_creado_por", fields: [creado_por_id], references: [id], onDelete: SetNull)

  @@unique([config_liquidacion_id, anio])
  @@index([anio, visible])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model configuraciones_salarios {
  id                     String                              @id @db.Uuid
  empresa_id             String?                             @db.Uuid
  salario_basico         Decimal                             @db.Decimal(12, 2)
  valor_hora_trabajador  Decimal                             @db.Decimal(12, 4)
  horas_mensuales_base   Int                                 @default(240)
  vigencia_desde         DateTime                            @db.Timestamptz(6)
  vigencia_hasta         DateTime?                           @db.Timestamptz(6)
  activo                 Boolean                             @default(true)
  observaciones          String?
  creado_por_id          String?                             @db.Uuid
  created_at             DateTime                            @db.Timestamptz(6)
  updated_at             DateTime                            @db.Timestamptz(6)
  deleted_at             DateTime?                           @db.Timestamptz(6)
  paga_dias_festivos     Boolean                             @default(false)
  porcentaje_festivos    Decimal                             @default(75.0000) @db.Decimal(8, 2)
  seguridad_social       Decimal                             @default(0.00) @db.Decimal(5, 2)
  administracion         Decimal                             @default(0.00) @db.Decimal(5, 2)
  prueba_antigeno_covid  Decimal                             @default(0.00) @db.Decimal(10, 2)
  prestaciones_sociales  Decimal                             @default(0.00) @db.Decimal(5, 2)
  /// Umbral de horas ordinarias para días normales. A partir de este
  /// valor se empiezan a contar horas extras (HED/HEN). Configurable
  /// por fecha para soportar cambios de normativa (ej: de 10.33h a
  /// otra cantidad en una fecha concreta).
  jornada_normal_horas   Decimal                             @default(10.33) @db.Decimal(4, 2)
  /// Umbral de horas ordinarias para domingos/festivos. Después de
  /// este valor se cuentan extras festivas (HEFD/HEFN). Configurable
  /// por fecha.
  jornada_festiva_horas  Decimal                             @default(7.33) @db.Decimal(4, 2)
  sede                   enum_configuraciones_salarios_sede?
  usuarios               usuarios?                           @relation(fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes               clientes?                           @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detalles_recargos_dias detalles_recargos_dias[]

  @@index([activo, vigencia_desde], map: "idx_config_salario_activo_vigencia")
  @@index([empresa_id, vigencia_desde], map: "idx_config_salario_empresa_vigencia")
  @@index([paga_dias_festivos], map: "idx_config_salario_paga_festivos")
  @@index([porcentaje_festivos], map: "idx_config_salario_porcentaje_festivos")
  @@index([activo, vigencia_desde, vigencia_hasta], map: "idx_config_salarios_activo_vigencia")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model detalles_recargos_dias {
  id                                                     String                    @id @db.Uuid
  dia_laboral_id                                         String                    @db.Uuid
  tipo_recargo_id                                        String                    @db.Uuid
  horas                                                  Decimal                   @default(0) @db.Decimal(4, 2)
  valor_hora_base                                        Decimal?                  @db.Decimal(12, 4)
  valor_calculado                                        Decimal?                  @db.Decimal(12, 2)
  /// Snapshot del porcentaje aplicado al momento del cálculo.
  /// Hace inmutable el valor aunque cambien las vigencias de tipos_recargos a futuro.
  /// Para registros antiguos, se rellena con el % actual del tipo_recargo al backfill.
  porcentaje_aplicado                                    Decimal?                  @db.Decimal(8, 2)
  /// Snapshot del valor hora efectivo (salario_basico / horas_mensuales_base) al momento del cálculo.
  /// Para horas extras = valorHora × (1 + porcentaje/100). Para recargos = valorHora × porcentaje/100.
  valor_hora_calculado                                   Decimal?                  @db.Decimal(12, 4)
  /// FK a la configuración salarial concreta usada ese día (para auditoría).
  /// Nullable para back-compat con registros antiguos que no la tenían.
  configuracion_salario_id                               String?                   @db.Uuid
  /// Fecha real (YYYY-MM-DD) a la que aplica este detalle. Permite que un mismo
  /// recargo_planilla tenga detalles con distintas configs cuando la planilla cruza
  /// un cambio de vigencia (ej. 1-14 jul con config vieja, 15-30 jul con la nueva).
  fecha_aplicacion                                       DateTime?                 @db.Date
  /// Snapshot del umbral de horas ordinarias para día normal usado al
  /// calcular este detalle. Hace inmutable el valor aunque cambie la
  /// config a futuro. Nullable para back-compat con registros antiguos.
  jornada_normal_horas                                   Decimal?                  @db.Decimal(4, 2)
  /// Snapshot del umbral de horas ordinarias para domingo/festivo.
  /// Nullable para back-compat con registros antiguos.
  jornada_festiva_horas                                  Decimal?                  @db.Decimal(4, 2)
  observaciones                                          String?
  calculado_automaticamente                              Boolean                   @default(true)
  activo                                                 Boolean                   @default(true)
  version                                                Int                       @default(1)
  creado_por_id                                          String?                   @db.Uuid
  actualizado_por_id                                     String?                   @db.Uuid
  created_at                                             DateTime                  @db.Timestamptz(6)
  updated_at                                             DateTime                  @db.Timestamptz(6)
  deleted_at                                             DateTime?                 @db.Timestamptz(6)
  users_detalles_recargos_dias_actualizado_por_idTousers usuarios?                 @relation("detalles_recargos_dias_actualizado_por_idTousers", fields: [actualizado_por_id], references: [id])
  users_detalles_recargos_dias_creado_por_idTousers      usuarios?                 @relation("detalles_recargos_dias_creado_por_idTousers", fields: [creado_por_id], references: [id])
  dias_laborales_planillas                               dias_laborales_planillas  @relation(fields: [dia_laboral_id], references: [id], onDelete: Cascade)
  tipos_recargos                                         tipos_recargos            @relation(fields: [tipo_recargo_id], references: [id])
  configuraciones_salarios                               configuraciones_salarios? @relation(fields: [configuracion_salario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activo], map: "idx_detalle_recargo_activo")
  @@index([calculado_automaticamente], map: "idx_detalle_recargo_automatico")
  @@index([configuracion_salario_id], map: "idx_detalle_recargo_config_salario")
  @@index([created_at], map: "idx_detalle_recargo_created")
  @@index([dia_laboral_id], map: "idx_detalle_recargo_dia")
  @@index([fecha_aplicacion], map: "idx_detalle_recargo_fecha_aplicacion")
  @@index([horas], map: "idx_detalle_recargo_horas")
  @@index([tipo_recargo_id], map: "idx_detalle_recargo_tipo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dias_laborales_planillas {
  id                                                       String                   @id @db.Uuid
  recargo_planilla_id                                      String                   @db.Uuid
  dia                                                      Int
  hora_inicio                                              Decimal?                 @db.Decimal(4, 2)

  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @updatedAt @db.Timestamptz(6)
  /// Nace NULL. Ver la migración 20260902100000: la cascada desde la cabecera
  /// borraba estos ítems FÍSICAMENTE, así que restaurar una liquidación
  /// devolvía un encabezado sin filas y con totales que no cuadraban.
  deleted_at              DateTime?                 @db.Timestamptz(6)
  /// Identificador que pone el cliente a las filas que aún no tienen `id` de

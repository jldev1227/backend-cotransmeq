model nomina_periodo_snapshot {
  id              String                    @id @default(uuid()) @db.Uuid
  anio            Int
  mes             Int
  /// Rama lógica. "main" = estado vigente; cualquier otra es histórico.
  rama            String                    @default("main") @db.VarChar(60)
  /// Autoincremental por periodo. version=1 es la más antigua.
  version         Int
  /// "manual" (cambio explícito), "auto" (cron horario), "revert".
  origen          String                    @default("manual") @db.VarChar(20)
  /// Snapshot desde el que se revirtió, cuando origen=revert.
  revertido_de_id String?                   @db.Uuid
  /// Null solo en los "auto" del cron.
  usuario_id      String?                   @db.Uuid
  /// El libro completo: cabecera del periodo, hojas, conceptos y totales.
  payload         Json                      @db.JsonB
  /// Resumen de cambios respecto a la versión anterior.
  diff            Json?                     @db.JsonB
  created_at      DateTime                  @default(now()) @db.Timestamptz(6)
  usuario         usuarios?                 @relation("nomina_snapshot_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  revertido_de    nomina_periodo_snapshot?  @relation("nomina_snapshot_revertido_de", fields: [revertido_de_id], references: [id], onDelete: SetNull)
  revertidos      nomina_periodo_snapshot[] @relation("nomina_snapshot_revertido_de")

  @@unique([anio, mes, version])
  @@index([anio, mes, rama])
  @@index([created_at])
  @@index([usuario_id])
}


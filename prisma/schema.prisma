model liquidacion_tercero_final {
  id                       String                                       @id @default(uuid()) @db.Uuid
  consecutivo              String                                       @unique @db.VarChar(50)
  liquidacion_servicio_id  String                                       @db.Uuid
  tercero_id               String?                                      @db.Uuid
  vehiculo_id              String?                                      @db.Uuid
  placa                    String                                       @db.VarChar(20)
  mes                      Int
  anio                     Int
  valor_liquidar           Decimal                                      @default(0) @db.Decimal(12, 2)
  total_costos_laborales   Decimal                                      @default(0) @db.Decimal(12, 2)
  total_gastos_operativos  Decimal                                      @default(0) @db.Decimal(12, 2)
  total_impuestos          Decimal                                      @default(0) @db.Decimal(12, 2)
  total_descuentos         Decimal                                      @default(0) @db.Decimal(12, 2)
  total_pagar              Decimal                                      @default(0) @db.Decimal(12, 2)
  estado                   String                                       @default("BORRADOR") @db.VarChar(20)
  motivo_anulacion         String?
  creado_por_id            String?                                      @db.Uuid
  actualizado_por_id       String?                                      @db.Uuid
  /// Marca el cierre como multi-propietario. Cuando `true`, el reparto del
  /// valor a pagar se hace porcentualmente entre los N copropietarios
  /// listados en `liquidacion_tercero_final_propietario`, y los conceptos
  /// de IMPUESTO se prorratean una vez por copropietario. Los porcentajes
  /// NO se validan contra 100% — el usuario puede excederse (ej. 115%).
  es_multi_propietario     Boolean                                      @default(false)
  /// DEPRECADO — sustituido por la tabla `liquidacion_tercero_final_adicional`.
  ///
  /// Se conserva como respaldo del backfill y porque el canvas del cierre
  /// final individual (fuera del alcance de la migración) todavía escribe
  /// aquí vía socket. Mientras ambos convivan, el gateway hace DOBLE
  /// ESCRITURA (JSONB + tabla) para que no diverjan.
  /// TODO(2026-Q4): migrar el canvas individual a la tabla y dropear esta
  /// columna en una segunda migración.
  adicionales              Json                                         @default("[]") @db.JsonB
  /// Override manual del flag `es_propietario` por conductor en esta liquidación.
  /// Map: { "conductorId": true | false }.
  /// Si el conductor no aparece en el map, se usa la auto-detección
  /// (conductor.numero_identificacion == vehiculo.propietario_identificacion).
  /// Solo aplica a DOTACION (excluye al propietario de los días base).
  es_propietario_overrides Json                                         @default("{}") @db.JsonB
  /// Concurrencia optimista del cambio de estado. Evita que dos usuarios
  /// aprueben/anulen a la vez desde el header del canvas y uno pise al otro.
  version                  Int                                          @default(1)
  /// Color de la pestaña en el canvas de cierres finales (#RRGGBB o
  /// #RRGGBBAA). NULL = automático, derivado del estado con la misma paleta
  /// que los badges del header. Con valor = override manual del usuario, que
  /// gana sobre el estado y sobrevive a las recargas.
  color_hoja               String?                                      @db.VarChar(9)
  created_at               DateTime                                     @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                                     @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime?                                    @db.Timestamptz(6)
  liquidacion_servicio     liquidacion_servicio                         @relation(fields: [liquidacion_servicio_id], references: [id], onDelete: Cascade)
  tercero                  terceros?                                    @relation(fields: [tercero_id], references: [id])
  vehiculo                 vehiculos?                                   @relation(fields: [vehiculo_id], references: [id])
  usuarios_creado_por      usuarios?                                    @relation("liquidacion_tercero_final_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_actualizado_por usuarios?                                    @relation("liquidacion_tercero_final_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                    liquidacion_tercero_final_item[]
  conceptos                liquidacion_tercero_final_concepto[]
  propietarios             liquidacion_tercero_final_propietario[]
  adicionales_filas        liquidacion_tercero_final_adicional[]
  chat_mensajes            liquidacion_chat_mensaje[]
  recordatorios_origen     liquidacion_recordatorio[]                   @relation("recordatorio_origen")
  recordatorios_aplicados  liquidacion_recordatorio[]                   @relation("recordatorio_aplicado")
  snapshots                liquidacion_tercero_final_snapshot[]
  historial_estados        historial_estado_liquidacion_tercero_final[]
  envios                   liquidacion_tercero_envio[]

  @@index([liquidacion_servicio_id])
  @@index([tercero_id])
  @@index([vehiculo_id])
  @@index([placa])
  @@index([anio, mes])
  @@index([estado])
  /// Consulta del canvas: todos los cierres de un periodo, ordenados por
  /// placa. El `@@index([anio, mes])` existente no cubre el orden ni filtra
  /// los soft-deleted, que son la mayoría en periodos antiguos.
  @@index([anio, mes, placa], map: "idx_lt_final_periodo_placa")
}

model historial_estado_liquidacion_tercero_final {
  id                           String   @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String   @db.Uuid

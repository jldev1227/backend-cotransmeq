/// Cierre final de la liquidación de un tercero.
/// REFERENCIA los items de liquidacion_tercero (que son filas de la
/// liquidación de servicio) a través de la tabla pivote
/// liquidacion_tercero_final_item, y guarda SUS PROPIOS conceptos de
/// descuento en liquidacion_tercero_final_concepto.
/// Es la entidad que lista la página "Liquidaciones de Terceros".
model liquidacion_tercero_final {
  id                       String                                       @id @default(uuid()) @db.Uuid
  consecutivo              String                                       @unique @db.VarChar(50)
  liquidacion_servicio_id  String                                       @db.Uuid
  tercero_id               String?                                      @db.Uuid
  vehiculo_id              String?                                      @db.Uuid
  placa                    String                                       @db.VarChar(20)
  mes                      Int
  anio                     Int
  valor_liquidar           Decimal                                      @default(0) @db.Decimal(12, 2)
  total_costos_laborales   Decimal                                      @default(0) @db.Decimal(12, 2)
  total_gastos_operativos  Decimal                                      @default(0) @db.Decimal(12, 2)
  total_impuestos          Decimal                                      @default(0) @db.Decimal(12, 2)
  total_descuentos         Decimal                                      @default(0) @db.Decimal(12, 2)
  total_pagar              Decimal                                      @default(0) @db.Decimal(12, 2)
  estado                   String                                       @default("BORRADOR") @db.VarChar(20)
  motivo_anulacion         String?
  creado_por_id            String?                                      @db.Uuid
  actualizado_por_id       String?                                      @db.Uuid
  /// Marca el cierre como multi-propietario. Cuando `true`, el reparto del
  /// valor a pagar se hace porcentualmente entre los N copropietarios
  /// listados en `liquidacion_tercero_final_propietario`, y los conceptos
  /// de IMPUESTO se prorratean una vez por copropietario. Los porcentajes
  /// NO se validan contra 100% — el usuario puede excederse (ej. 115%).
  es_multi_propietario     Boolean                                      @default(false)
  /// DEPRECADO — sustituido por la tabla `liquidacion_tercero_final_adicional`.
  ///
  /// Se conserva como respaldo del backfill y porque el canvas del cierre
  /// final individual (fuera del alcance de la migración) todavía escribe
  /// aquí vía socket. Mientras ambos convivan, el gateway hace DOBLE
  /// ESCRITURA (JSONB + tabla) para que no diverjan.
  /// TODO(2026-Q4): migrar el canvas individual a la tabla y dropear esta
  /// columna en una segunda migración.
  adicionales              Json                                         @default("[]") @db.JsonB
  /// Override manual del flag `es_propietario` por conductor en esta liquidación.
  /// Map: { "conductorId": true | false }.
  /// Si el conductor no aparece en el map, se usa la auto-detección
  /// (conductor.numero_identificacion == vehiculo.propietario_identificacion).
  /// Solo aplica a DOTACION (excluye al propietario de los días base).
  es_propietario_overrides Json                                         @default("{}") @db.JsonB
  /// Concurrencia optimista del cambio de estado. Evita que dos usuarios
  /// aprueben/anulen a la vez desde el header del canvas y uno pise al otro.
  version                  Int                                          @default(1)
  /// Color de la pestaña en el canvas de cierres finales (#RRGGBB o
  /// #RRGGBBAA). NULL = automático, derivado del estado con la misma paleta
  /// que los badges del header. Con valor = override manual del usuario, que
  /// gana sobre el estado y sobrevive a las recargas.
  color_hoja               String?                                      @db.VarChar(9)
  created_at               DateTime                                     @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                                     @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime?                                    @db.Timestamptz(6)
  liquidacion_servicio     liquidacion_servicio                         @relation(fields: [liquidacion_servicio_id], references: [id], onDelete: Cascade)
  tercero                  terceros?                                    @relation(fields: [tercero_id], references: [id])
  vehiculo                 vehiculos?                                   @relation(fields: [vehiculo_id], references: [id])
  usuarios_creado_por      usuarios?                                    @relation("liquidacion_tercero_final_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_actualizado_por usuarios?                                    @relation("liquidacion_tercero_final_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                    liquidacion_tercero_final_item[]
  conceptos                liquidacion_tercero_final_concepto[]
  propietarios             liquidacion_tercero_final_propietario[]
  adicionales_filas        liquidacion_tercero_final_adicional[]
  chat_mensajes            liquidacion_chat_mensaje[]
  recordatorios_origen     liquidacion_recordatorio[]                   @relation("recordatorio_origen")
  recordatorios_aplicados  liquidacion_recordatorio[]                   @relation("recordatorio_aplicado")
  snapshots                liquidacion_tercero_final_snapshot[]
  historial_estados        historial_estado_liquidacion_tercero_final[]

  @@index([liquidacion_servicio_id])
  @@index([tercero_id])
  @@index([vehiculo_id])
  @@index([placa])
  @@index([anio, mes])
  @@index([estado])
  /// Consulta del canvas: todos los cierres de un periodo, ordenados por
  /// placa. El `@@index([anio, mes])` existente no cubre el orden ni filtra
  /// los soft-deleted, que son la mayoría en periodos antiguos.
  @@index([anio, mes, placa], map: "idx_lt_final_periodo_placa")
}

/// Historial de cambios de estado de un cierre final.
///
/// `historial_estado_liquidacion` NO sirve: su FK apunta a
/// `liquidacion_servicio`, no al cierre final, y el módulo de terceros nunca
/// ha escrito ahí. Hasta ahora el historial de estados solo se podía
/// reconstruir deserializando los payloads JSONB de
/// `liquidacion_tercero_final_snapshot`, que es caro y frágil.
///
/// El header del canvas necesita mostrar "aprobada por X el día Y" de un
/// vistazo, para las N hojas del periodo.
model historial_estado_liquidacion_tercero_final {
  id                           String   @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String   @db.Uuid
  estado_anterior              String?  @db.VarChar(20)
  estado_nuevo                 String   @db.VarChar(20)
  /// NULL si el cambio lo hizo un proceso automático.
  usuario_id                   String?  @db.Uuid
  /// Obligatorio de facto al pasar a ANULADA (lo valida el service).
  motivo                       String?
  created_at                   DateTime @default(now()) @db.Timestamptz(6)

  liquidacion_tercero_final liquidacion_tercero_final @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuario                   usuarios?                 @relation("historial_estado_lt_final_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([liquidacion_tercero_final_id, created_at], map: "idx_hist_estado_lt_final_cierre")
  @@index([usuario_id], map: "idx_hist_estado_lt_final_usuario")
}

/// Filas virtuales adicionales de un cierre final (ej: pagos manuales a
/// propietarios que no provienen de un item de `liquidacion_servicio`).
///
/// SUSTITUYE al array JSONB `liquidacion_tercero_final.adicionales`. El
/// motivo del cambio es la edición concurrente: el JSONB no tiene PK, así
/// que el canvas identificaba cada fila por su posición (`${cierre_id}::${idx}`)
/// y el guardado reemplazaba el array COMPLETO por cierre. Dos usuarios
/// editando el mismo cierre se pisaban, y bastaba con que una fila cambiara
/// de posición para que los bindings del canvas apuntaran a la fila
/// equivocada.
///
/// Con tabla real cada fila tiene id UUID estable, se actualiza sola
/// (`UPDATE ... WHERE id`) y `version` permite concurrencia optimista:
/// `WHERE id = $id AND version = $base` — si no afecta filas, hubo conflicto.
model liquidacion_tercero_final_adicional {
  id                           String    @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String    @db.Uuid
  /// Posición dentro del cierre. Es presentación, NO identidad.
  orden                        Int       @default(0)
  cliente                      String    @default("TRANSMERALDA") @db.VarChar(255)
  placa                        String    @db.VarChar(20)
  tercero_id                   String?   @db.Uuid
  tercero_nombre               String?   @db.VarChar(255)
  vehiculo_id                  String?   @db.Uuid
  recorrido                    String?   @db.VarChar(500)
  fechas                       String?   @db.VarChar(100)
  valor_unitario               Decimal   @default(0) @db.Decimal(12, 2)
  cantidad                     Decimal   @default(1) @db.Decimal(10, 2)
  porcentaje_admin             Decimal   @default(0) @db.Decimal(5, 2)
  valor_admin                  Decimal   @default(0) @db.Decimal(12, 2)
  valor_liquidar               Decimal   @default(0) @db.Decimal(12, 2)
  /// true si la fila entra en la base de impuestos ICA/AT/SB/RETE_FUENTE.
  aplica_impuestos             Boolean   @default(true)
  /// Concurrencia optimista. Se incrementa en cada UPDATE aceptado.
  version                      Int       @default(1)
  creado_por_id                String?   @db.Uuid
  actualizado_por_id           String?   @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at                   DateTime? @db.Timestamptz(6)

  cierre                   liquidacion_tercero_final @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuarios_creado_por      usuarios?                 @relation("lt_final_adicional_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_actualizado_por usuarios?                 @relation("lt_final_adicional_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Nombres explícitos: los autogenerados se truncan a 63 caracteres y
  // ambos índices colapsarían al mismo identificador.
  @@index([liquidacion_tercero_final_id], map: "idx_lt_final_adicional_cierre")
  @@index([liquidacion_tercero_final_id, orden], map: "idx_lt_final_adicional_cierre_orden")
  @@index([deleted_at], map: "idx_lt_final_adicional_deleted_at")
}

/// Snapshot de los adicionales de un PERIODO completo (mes/año).
///
/// A diferencia de los snapshots del ocasional, aquí no hay cabecera a la que
/// colgarse: los adicionales pertenecen a N cierres finales distintos del
/// mismo mes. Por eso la identidad del snapshot es `(anio, mes, version)`.
///
/// `payload` guarda todas las filas vivas del periodo con su `cierre_id`, de
/// modo que revertir es soft-delete de lo vigente + re-insert desde el payload.
model liquidacion_tercero_adicional_periodo_snapshot {
  id              String   @id @default(uuid()) @db.Uuid
  anio            Int
  mes             Int
  /// "main" = vigente. Otra rama = histórico.
  rama            String   @default("main") @db.VarChar(60)
  version         Int
  /// "manual" | "auto" (cron) | "revert"
  origen          String   @default("manual") @db.VarChar(20)
  /// Snapshot desde el que se revirtió (cuando origen=revert).
  revertido_de_id String?  @db.Uuid
  /// Null solo en "auto" del cron.
  usuario_id      String?  @db.Uuid
  payload         Json     @db.JsonB
  /// Resumen de cambios respecto a la versión anterior.
  diff            Json?    @db.JsonB
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  usuario      usuarios?                                        @relation("snapshot_adicional_periodo_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  revertido_de liquidacion_tercero_adicional_periodo_snapshot?  @relation("snapshot_adicional_periodo_revertido_de", fields: [revertido_de_id], references: [id], onDelete: SetNull)
  revertidos   liquidacion_tercero_adicional_periodo_snapshot[] @relation("snapshot_adicional_periodo_revertido_de")

  @@unique([anio, mes, version], map: "uniq_lt_adic_periodo_snapshot_version")
  @@index([anio, mes, rama], map: "idx_lt_adic_periodo_snapshot_periodo")
  @@index([created_at], map: "idx_lt_adic_periodo_snapshot_created")
  @@index([usuario_id], map: "idx_lt_adic_periodo_snapshot_usuario")
}

/// Tabla pivote N:M entre liquidacion_tercero_final y los items de

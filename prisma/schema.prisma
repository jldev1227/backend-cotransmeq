  cantidad                     Decimal   @default(1) @db.Decimal(10, 2)
  porcentaje_admin             Decimal   @default(0) @db.Decimal(5, 2)
  valor_admin                  Decimal   @default(0) @db.Decimal(12, 2)
  valor_liquidar               Decimal   @default(0) @db.Decimal(12, 2)
  /// true si la fila entra en la base de impuestos ICA/AT/SB/RETE_FUENTE.
  aplica_impuestos             Boolean   @default(true)
  /// Concurrencia optimista. Se incrementa en cada UPDATE aceptado.
  version                      Int       @default(1)
  creado_por_id                String?   @db.Uuid
  actualizado_por_id           String?   @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at                   DateTime? @db.Timestamptz(6)

  cierre                   liquidacion_tercero_final               @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuarios_creado_por      usuarios?                               @relation("lt_final_adicional_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_actualizado_por usuarios?                               @relation("lt_final_adicional_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingreso_filas            liquidacion_ingreso_transmeralda_fila[] @relation("liquidacion_ingreso_fila_adicional")

  // Nombres explícitos: los autogenerados se truncan a 63 caracteres y
  // ambos índices colapsarían al mismo identificador.
  @@index([liquidacion_tercero_final_id], map: "idx_lt_final_adicional_cierre")
  @@index([liquidacion_tercero_final_id, orden], map: "idx_lt_final_adicional_cierre_orden")
  @@index([deleted_at], map: "idx_lt_final_adicional_deleted_at")
}

model liquidacion_tercero_adicional_periodo_snapshot {

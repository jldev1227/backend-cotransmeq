/// Borrador previo de una liquidación de servicios.
///
/// Cubre la fase en la que el autoguardado todavía NO puede crear la fila real:
/// `cliente_id` y `consecutivo` son obligatorios en `liquidacion_servicio`, así
/// que hasta que el usuario elija cliente y escriba consecutivo no hay nada que
/// insertar. En cuanto los hay, el autoguardado crea la fila y este borrador se
/// borra.
///
/// A diferencia de la fila real, esto SÍ es privado: un borrador a medio
/// escribir, sin cliente siquiera, no es información de nadie más.
model liquidacion_servicio_draft {
  id             String   @id @default(uuid()) @db.Uuid
  usuario_id     String   @db.Uuid
  /// NULL = la liquidación todavía no existe.
  liquidacion_id String?  @db.Uuid
  /// Exactamente lo que devuelve `buildDraftPayload()` en el editor.
  payload        Json     @db.JsonB
  version        Int      @default(1)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  usuario     usuarios              @relation("liq_svc_draft_usuario", fields: [usuario_id], references: [id], onDelete: Cascade)
  liquidacion liquidacion_servicio? @relation(fields: [liquidacion_id], references: [id], onDelete: Cascade)

  /// La UNICIDAD REAL son dos índices parciales que Prisma no sabe expresar
  /// (`WHERE liquidacion_id IS NULL` y `WHERE liquidacion_id IS NOT NULL`), y
  /// viven en `migrations/31-08-2026-borrador-previo-servicios.sql`. Un
  /// `@@unique([usuario_id, liquidacion_id])` aquí NO valdría: en Postgres dos
  /// NULL no colisionan, así que el mismo usuario acumularía borradores
  /// «nuevos» sin que ninguno fuera el bueno. Por eso el servicio usa
  /// `findFirst` + `create`/`update` y no `upsert`.
  @@index([usuario_id])
  @@index([liquidacion_id])
  @@index([updated_at])
}

/// Catálogo de operadoras.
///
/// Nace para sustituir el `liquidacion_servicio.operadora` de texto libre, que
/// no tenía enum, ni default, ni una sola validación en ninguna capa: se podía
/// persistir cualquier cadena y no había forma de añadir una operadora sin
/// tocar código en dos repos.
///
/// NO gobierna `tarifas_servicios.operadora`: ahí la palabra significa otra
/// cosa —selecciona la tabla de precios— y su dominio no admite 'OTRA'.
model operadoras {
  id         String   @id @default(uuid()) @db.Uuid
  /// Normalizado (mayúsculas, sin espacios sobrantes). Es la clave con la que
  /// casan el backfill, el seed y las altas; no se edita.
  codigo     String   @unique @db.VarChar(40)
  /// Etiqueta visible. Sí se edita.
  nombre     String   @db.VarChar(120)
  /// Retirar una operadora sin romper la FK de las liquidaciones históricas.
  activo     Boolean  @default(true)
  /// Orden del <select>; el alfabético no sirve.
  orden      Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  liquidaciones liquidacion_servicio[]

  @@index([activo, orden])
}

model liquidacion_servicio {
  id                         String                           @id @default(uuid()) @db.Uuid
  consecutivo                String                           @unique @db.VarChar(50)
  cliente_id                 String                           @db.Uuid
  mes                        Int
  anio                       Int
  fecha_liquidacion          DateTime                         @default(now()) @db.Timestamptz(6)
  valor_servicios            Decimal                          @default(0) @db.Decimal(15, 2)
  valor_recargos             Decimal                          @default(0) @db.Decimal(15, 2)
  valor_transporte_adicional Decimal                          @default(0) @db.Decimal(15, 2)
  valor_administracion_ta    Decimal                          @default(0) @db.Decimal(15, 2)
  valor_pernoctes            Decimal                          @default(0) @db.Decimal(15, 2)
  cantidad_pernoctes         Int                              @default(0)
  valor_unitario_pernoctes   Decimal                          @default(0) @db.Decimal(12, 2)
  subtotal                   Decimal                          @default(0) @db.Decimal(15, 2)
  porcentaje_iva             Decimal                          @default(0) @db.Decimal(5, 2)
  valor_iva                  Decimal                          @default(0) @db.Decimal(15, 2)
  total                      Decimal                          @default(0) @db.Decimal(15, 2)
  recargos_data              Json?
  estado                     estado_liquidacion_servicio_enum @default(BORRADOR)
  motivo_anulacion           String?
  observaciones              String?
  osi                        String?
  /// Texto libre heredado. Se conserva junto a `operadora_id` mientras dure la
  /// transición: lo siguen leyendo el canvas y el exportador de Excel. Ver
  /// `migrations/31-08-2026-operadoras-catalogo.sql`.
  operadora                  String?
  operadora_id               String?                          @db.Uuid
  /// Testigo del compare-and-swap del autoguardado. `updated_at` no sirve: es
  /// `@updatedAt` y cambia por cosas que no son edición del usuario.
  version                    Int                              @default(1)
  /// NULL = nació de un autoguardado y nadie ha pulsado Guardar. Es lo que la
  /// mantiene fuera del listado y del canvas de los demás.
  confirmada_at              DateTime?                        @db.Timestamptz(6)
  /// Clave de idempotencia que genera el editor, una por sesión de edición.
  /// Sin ella, dos autoguardados en vuelo a la vez crean dos liquidaciones.
  ///
  /// El SQL crea un índice único PARCIAL (`WHERE cliente_key IS NOT NULL`) y
  /// aquí es `@unique` a secas, que Prisma traduce a uno completo. En Postgres
  /// se comportan igual —los NULL no colisionan en ninguno de los dos—; la
  /// diferencia es que el parcial no indexa las millones de filas sin clave.
  cliente_key                String?                          @unique @db.Uuid
  tercero_liquidado          Boolean                          @default(false)
  creado_por_id              String?                          @db.Uuid
  actualizado_por_id         String?                          @db.Uuid
  liquidado_por_id           String?                          @db.Uuid
  aprobado_por_id            String?                          @db.Uuid
  fecha_aprobacion           DateTime?                        @db.Timestamptz(6)
  fecha_facturacion          DateTime?                        @db.Timestamptz(6)
  created_at                 DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                         @updatedAt @db.Timestamptz(6)
  deleted_at                 DateTime?                        @db.Timestamptz(6)
  actualizado_por            usuarios?                        @relation("liq_serv_actualizado_por", fields: [actualizado_por_id], references: [id])
  aprobado_por               usuarios?                        @relation("liq_serv_aprobado_por", fields: [aprobado_por_id], references: [id])
  cliente                    clientes                         @relation(fields: [cliente_id], references: [id])
  creado_por                 usuarios?                        @relation("liq_serv_creado_por", fields: [creado_por_id], references: [id])
  liquidado_por              usuarios?                        @relation("liq_serv_liquidado_por", fields: [liquidado_por_id], references: [id])
  items                      liquidacion_servicio_item[]
  terceros_items             liquidacion_tercero[]
  historial_estados          historial_estado_liquidacion[]
  factura_items              factura_liquidacion_item[]
  operadora_rel              operadoras?                      @relation(fields: [operadora_id], references: [id], onDelete: Restrict)
  drafts                     liquidacion_servicio_draft[]

  liquidaciones_tercero_final liquidacion_tercero_final[]

  @@index([cliente_id])
  @@index([mes, anio])
  @@index([estado])
  @@index([deleted_at])
  @@index([operadora_id])
  @@index([confirmada_at])
}

model liquidacion_servicio_item {
  id                      String                    @id @default(uuid()) @db.Uuid
  liquidacion_id          String                    @db.Uuid
  servicio_id             String?                   @db.Uuid
  recargo_planilla_id     String?                   @db.Uuid
  tercero_id              String?                   @db.Uuid
  placa                   String                    @db.VarChar(20)
  fecha_inicial           DateTime                  @db.Date
  fecha_final             DateTime                  @db.Date
  recorrido               String                    @db.VarChar(500)
  tipo_servicio           tipo_servicio_tarifa_enum
  cantidad                Decimal                   @default(1) @db.Decimal(10, 2)
  valor_unitario          Decimal                   @db.Decimal(15, 2)
  subtotal                Decimal                   @db.Decimal(15, 2)
  porcentaje_descuento    Decimal                   @default(0) @db.Decimal(5, 2)
  valor_final             Decimal                   @db.Decimal(15, 2)
  numero_planilla         String?                   @db.VarChar(50)
  recargos_detalle        Json?
  valor_recargos_total    Decimal                   @default(0) @db.Decimal(15, 2)

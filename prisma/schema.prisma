/// CABECERA de la liquidación MENSUAL de adicionales de terceros.
///
/// Consolida los `adicionales` (filas virtuales) presentes en TODOS los
/// cierres finales `liquidacion_tercero_final` de un mismo mes/año,
/// independientemente de la placa. Permite editarlos, agregar/eliminar
/// nuevos, asociar gastos operativos abiertos (PAPELERIA, GASTOS_DIVERSOS,
/// etc), anticipos y aplicar impuestos a nivel mensual.
///
/// Al guardar (ver `liquidaciones-terceros-mensual.service.ts`), el
/// sistema distribuye los adicionales a los cierres finales
/// correspondientes por placa (o crea uno nuevo si no existe) y aplica
/// los conceptos mensuales prorrateados o por cierre según la regla
/// de cada tipo.
///
/// Si en el mes existen cierres finales en estado APROBADA o
/// FACTURADA, el guardado marca los previos como REEMPLAZADA y crea
/// los nuevos (consistente con `guardarBorrador`).
model liquidacion_tercero_ocasional {
  id               String  @id @default(uuid()) @db.Uuid
  /// Consecutivo único formato LOC-{mes}-{anio}-{seq}, ej: LOC-07-2026-0001
  consecutivo      String  @unique @db.VarChar(50)
  /// Mes y año que consolida esta liquidación.
  mes              Int
  anio             Int
  estado           String  @default("BORRADOR") @db.VarChar(20)
  motivo_anulacion String? @db.Text
  observaciones    String? @db.Text

  // ── Totales derivados (denormalizados para listar rápido) ──
  /// Suma de `valor_liquidar` de todos los adicionales.
  total_adicionales       Decimal @default(0) @db.Decimal(14, 2)
  /// Suma de conceptos tipo GASTO_OPERATIVO (PAPELERIA, GASTOS_DIVERSOS, etc).
  total_gastos_operativos Decimal @default(0) @db.Decimal(14, 2)
  /// Suma de conceptos tipo IMPUESTO.
  total_impuestos         Decimal @default(0) @db.Decimal(14, 2)
  /// Suma de conceptos tipo ANTICIPO.
  total_anticipos         Decimal @default(0) @db.Decimal(14, 2)
  /// total_gastos_operativos + total_impuestos + total_anticipos.
  total_descuentos        Decimal @default(0) @db.Decimal(14, 2)
  /// total_adicionales - total_descuentos (puede ser negativo).
  total_pagar             Decimal @default(0) @db.Decimal(14, 2)
  /// Total facturado de TODOS los items (espejo del Excel: Σ total_facturado).
  total_facturado_items   Decimal @default(0) @db.Decimal(14, 2)
  /// Total administración de TODOS los items (Σ valor_admin).
  total_admin_items       Decimal @default(0) @db.Decimal(14, 2)
  /// Total a liquidar de TODOS los items no excluidos (Σ valor_liquidar).
  total_liquidar_items    Decimal @default(0) @db.Decimal(14, 2)

  // ── Auditoría ──
  creado_por_id      String?   @db.Uuid
  actualizado_por_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  // ── Relaciones ──
  creado_por      usuarios?                                 @relation("liquidacion_tercero_ocasional_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actualizado_por usuarios?                                 @relation("liquidacion_tercero_ocasional_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adicionales     liquidacion_tercero_ocasional_adicional[]
  conceptos       liquidacion_tercero_ocasional_concepto[]
  items           liquidacion_tercero_ocasional_item[]
  drafts          liquidacion_tercero_ocasional_draft[]
  snapshots       liquidacion_tercero_ocasional_snapshot[]

  @@unique([mes, anio], name: "uniq_ocasional_periodo")
  @@index([mes, anio])
  @@index([estado])
  @@index([deleted_at])
  @@index([creado_por_id])
  @@index([actualizado_por_id])
}

/// Fila virtual de ADICIONAL dentro de la liquidación mensual.
/// Equivalente al array `adicionales` (JSON) que ya existe en
/// `liquidacion_tercero_final`, pero normalizado a tabla para permitir
/// CRUD con realtime collab, búsqueda, sort y reporting.
///
/// Almacena FK opcionales al cierre final de origen (del que se extrajo
/// al generar el borrador) y al cierre final destino (al que se asigna
/// al guardar la distribución). Ambos son nullables: el adicional puede
/// ser completamente nuevo (sin origen) o no tener destino asignado aún
/// (el backend decide el destino en función de la placa).
model liquidacion_tercero_ocasional_adicional {
  id                       String  @id @default(uuid()) @db.Uuid
  liquidacion_ocasional_id String  @db.Uuid
  /// Cliente para el cual se hizo el servicio adicional. Default "TRANSMERALDA".
  cliente                  String  @default("TRANSMERALDA") @db.VarChar(255)
  /// Placa objetivo del adicional.
  placa                    String  @db.VarChar(20)
  /// Tercero / propietario de placa asociado (opcional, se resuelve
  /// por la placa si está null en guardado).
  tercero_id               String? @db.Uuid
  tercero_nombre           String? @db.VarChar(255)
  vehiculo_id              String? @db.Uuid
  recorrido                String? @db.VarChar(500)
  fechas                   String? @db.VarChar(100)
  valor_unitario           Decimal @default(0) @db.Decimal(12, 2)
  cantidad                 Decimal @default(1) @db.Decimal(10, 2)
  porcentaje_admin         Decimal @default(0) @db.Decimal(5, 2)
  /// valor_unitario * cantidad * porcentaje_admin / 100 (calculado en backend).
  valor_admin              Decimal @default(0) @db.Decimal(12, 2)
  /// (valor_unitario * cantidad) - valor_admin (neto a liquidar al tercero).
  valor_liquidar           Decimal @default(0) @db.Decimal(12, 2)
  /// Si false, el adicional NO entra en la base de RETENCION_ICA,
  /// AVISOS_TABLEROS, SOBRETASA_BOMBERIL ni RETENCION_FUENTE al
  /// recalcular impuestos.
  aplica_impuestos         Boolean @default(true)
  orden                    Int     @default(0)
  /// Concurrencia optimista para la edición por celda del canvas.
  version                  Int     @default(1)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  // ── Relaciones ──
  liquidacion_ocasional liquidacion_tercero_ocasional @relation(fields: [liquidacion_ocasional_id], references: [id], onDelete: Cascade)
  tercero               terceros?                     @relation("ocasional_adicional_tercero", fields: [tercero_id], references: [id], onDelete: SetNull)
  vehiculo              vehiculos?                    @relation("ocasional_adicional_vehiculo", fields: [vehiculo_id], references: [id], onDelete: SetNull)

  @@index([liquidacion_ocasional_id])
  @@index([placa])
  @@index([tercero_id])
  @@index([deleted_at])
  @@index([liquidacion_ocasional_id, placa], map: "idx_ocasional_adicional_liquidacion_placa")
}

/// Item pivote dentro de la liquidación mensual.
/// Espejo de `liquidacion_tercero_item` con FK a la cabecera mensual.
/// Cada fila trae el detalle completo del servicio prestado por un
/// tercero ocasional en el mes (cliente, consecutivo, placa, 3°,
/// descripción, fechas, V/Unidad, Cant, Admon, Total, V/Liquidar,
/// # Planilla, Ing. Extras, # Factura) que es lo que aparece en el
/// Excel de planilla mensual.
///
/// Se genera automáticamente al crear el borrador a partir del pivote
/// `liquidacion_tercero` de los cierres finales seleccionados. El
/// usuario puede excluir items via `excluido = true` (soft) sin
/// borrarlos.
model liquidacion_tercero_ocasional_item {
  id                       String    @id @default(uuid()) @db.Uuid
  liquidacion_ocasional_id String    @db.Uuid
  /// Pivote original del que se extrajo el item. AHORA OBLIGATORIO — el
  /// item del ocasional SIEMPRE proviene de un `liquidacion_tercero`.
  liquidacion_tercero_id   String    @db.Uuid
  liquidacion_servicio_id  String?   @db.Uuid
  cliente_nombre           String    @db.VarChar(255)
  consecutivo              String    @db.VarChar(50)
  placa                    String    @db.VarChar(20)
  tercero_id               String?   @db.Uuid
  tercero_nombre           String    @db.VarChar(255)
  /// Para modal selector: documento / NIT del tercero
  tercero_documento        String?   @db.VarChar(50)
  recorrido                String    @db.VarChar(500)
  fechas                   String    @db.VarChar(100)
  valor_unitario           Decimal   @default(0) @db.Decimal(12, 2)
  cantidad                 Decimal   @default(1) @db.Decimal(10, 2)
  porcentaje_admin         Decimal   @default(0) @db.Decimal(5, 2)
  valor_admin              Decimal   @default(0) @db.Decimal(12, 2)
  total_facturado          Decimal   @default(0) @db.Decimal(12, 2)
  valor_liquidar           Decimal   @default(0) @db.Decimal(12, 2)
  numero_planilla          String?   @db.VarChar(50)
  ingreso_extra_global     Decimal   @default(0) @db.Decimal(12, 2)
  ingresos_extra_aval      Decimal   @default(0) @db.Decimal(12, 2)
  ingreso_empresa          Decimal   @default(0) @db.Decimal(12, 2)
  numero_factura           String?   @db.VarChar(50)
  /// true si el item entra en la base de impuestos ICA/AT/SB/RETE_FUENTE.
  aplica_impuestos         Boolean   @default(true)
  /// true si el usuario tachó el item con la X (soft-excluido del cálculo).
  excluido                 Boolean   @default(false)
  orden                    Int       @default(0)
  /// Concurrencia optimista para la edición por celda del canvas.
  version                  Int       @default(1)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime? @db.Timestamptz(6)

  liquidacion_ocasional liquidacion_tercero_ocasional @relation(fields: [liquidacion_ocasional_id], references: [id], onDelete: Cascade)
  liquidacion_tercero   liquidacion_tercero?          @relation("ocasional_item_pivote", fields: [liquidacion_tercero_id], references: [id], onDelete: Restrict)
  tercero               terceros?                     @relation("ocasional_item_tercero", fields: [tercero_id], references: [id], onDelete: SetNull)

  /// Idempotente: una sola fila ocasional por (cabecera, item_pivote).
  @@unique([liquidacion_ocasional_id, liquidacion_tercero_id], name: "uniq_ocasional_item_pivote")
  @@index([liquidacion_ocasional_id], map: "idx_ocasional_item_liquidacion_ocasional")
  @@index([placa])
  @@index([tercero_id])
  @@index([deleted_at])
  @@index([liquidacion_ocasional_id, excluido], map: "idx_ocasional_item_liquidacion_excluido")
}

/// Draft persistente de autoguardado por usuario/cabecera.
/// Permite que el usuario no pierda cambios al recargar la pestaña
/// o al cambiar de dispositivo. Solo se conserva el último draft
/// por (cabecera, usuario). El payload contiene TODO el estado
/// serializado del canvas Univer (items, adicionales, conceptos,
/// totales, sheetState, cursor).
model liquidacion_tercero_ocasional_draft {
  id                       String   @id @default(uuid()) @db.Uuid
  liquidacion_ocasional_id String   @db.Uuid
  usuario_id               String   @db.Uuid
  /// Estado serializado del canvas Univer
  payload                  Json     @db.JsonB
  /// Versión incremental del draft
  version                  Int      @default(1)
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @updatedAt @db.Timestamptz(6)

  liquidacion_ocasional liquidacion_tercero_ocasional @relation(fields: [liquidacion_ocasional_id], references: [id], onDelete: Cascade)
  usuario               usuarios                      @relation("ocasional_draft_usuario", fields: [usuario_id], references: [id], onDelete: Cascade)

  /// Solo se conserva el último draft por (cabecera, usuario)
  @@unique([liquidacion_ocasional_id, usuario_id], name: "uniq_ocasional_draft_user")
  @@index([liquidacion_ocasional_id])
  @@index([updated_at])
}

/// Concepto de descuento / gasto / impuesto / anticipo a nivel MENSUAL.
/// Espejo de `liquidacion_tercero_final_concepto` pero con FK a la
/// cabecera mensual. Tipos permitidos:
///   - GASTO_OPERATIVO (PAPELERIA, GASTOS_DIVERSOS, COMBUSTIBLE, etc)
///   - IMPUESTO (RETENCION_ICA, AVISOS_TABLEROS, etc)
///   - ANTICIPO
///
/// `placa_aplicada` (opcional): cuando se asigna, el concepto se aplica
/// SOLO al cierre final de esa placa. Si es null, se reparte prorrateado
/// entre todos los cierres destino proporcional al valor_liquidar de
/// los adicionales que apliquen.
model liquidacion_tercero_ocasional_concepto {
  id                       String    @id @default(uuid()) @db.Uuid
  liquidacion_ocasional_id String    @db.Uuid
  tipo                     String    @db.VarChar(50)
  concepto                 String    @db.VarChar(100)
  /// Opcional: si se quiere asociar el concepto a un conductor específico
  /// (típico para COSTO_LABORAL, pero la tabla ocasional no incluye costos
  /// laborales — el campo queda para futura extensión si aplica).
  conductor_id             String?   @db.Uuid
  /// Placa destino del concepto. Si null, se distribuye prorrateado.
  placa_aplicada           String?   @db.VarChar(20)
  dias                     Decimal?  @db.Decimal(10, 2)
  valor_unitario           Decimal   @default(0) @db.Decimal(12, 2)
  porcentaje               Decimal?  @db.Decimal(8, 4)
  valor_total              Decimal   @default(0) @db.Decimal(12, 2)
  base_calculo             Decimal?  @db.Decimal(12, 2)
  /// true si fue calculado por backend; false si fue cargado manual por el usuario.
  calculado                Boolean   @default(false)
  observaciones            String?   @db.Text
  orden                    Int       @default(0)
  /// Concurrencia optimista para la edición por celda del canvas.
  version                  Int       @default(1)
  actualizado_por_id       String?   @db.Uuid
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime? @db.Timestamptz(6)

  liquidacion_ocasional liquidacion_tercero_ocasional @relation(fields: [liquidacion_ocasional_id], references: [id], onDelete: Cascade)
  conductor             conductores?                  @relation("ocasional_concepto_conductor", fields: [conductor_id], references: [id], onDelete: SetNull)
  actualizado_por       usuarios?                     @relation("ocasional_concepto_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([liquidacion_ocasional_id])
  @@index([tipo])
  @@index([concepto])
  @@index([placa_aplicada])
  @@index([conductor_id])
  @@index([deleted_at])
}

/// Snapshot inmutable del estado completo de una liquidación mensual
/// de terceros. Espejo de `liquidacion_tercero_final_snapshot`.
/// Permite UNDO y trazabilidad campo a campo. Se genera en cada cambio
/// relevante y de forma horaria (cron).
model liquidacion_tercero_ocasional_snapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  liquidacion_ocasional_id String   @db.Uuid
  /// "main" = vigente. Otra rama = histórico.
  rama                     String   @default("main") @db.VarChar(60)
  version                  Int
  /// "manual" | "auto" (cron) | "revert"
  origen                   String   @default("manual") @db.VarChar(20)
  /// Snapshot desde el que se revirtió (cuando origen=revert).
  revertido_de_id          String?  @db.Uuid
  /// Null solo en "auto" del cron.
  usuario_id               String?  @db.Uuid
  /// Snapshot completo: cabecera + adicionales + conceptos + totales.
  payload                  Json     @db.JsonB
  /// Resumen de cambios respecto a la versión anterior.
  diff                     Json?    @db.JsonB
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  liquidacion_ocasional liquidacion_tercero_ocasional            @relation(fields: [liquidacion_ocasional_id], references: [id], onDelete: Cascade)
  usuario               usuarios?                                @relation("snapshot_ocasional_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  revertido_de          liquidacion_tercero_ocasional_snapshot?  @relation("snapshot_ocasional_revertido_de", fields: [revertido_de_id], references: [id], onDelete: SetNull)
  revertidos            liquidacion_tercero_ocasional_snapshot[] @relation("snapshot_ocasional_revertido_de")

  @@unique([liquidacion_ocasional_id, version])
  @@index([liquidacion_ocasional_id, rama])
  @@index([created_at])
  @@index([usuario_id])
}

/// Lugares personalizados (pozos, campamentos, patios de tanques, etc.)
/// que los usuarios registran manualmente cuando HERE no los conoce.
/// Aparecen en el autocomplete mezclados con los resultados de HERE.
model custom_places {
  id            String    @id @default(uuid()) @db.Uuid
  nombre        String    @db.VarChar(255)
  /// Categoría opcional: POZO, CAMPAMENTO, PATIO, VEREDA, FINCA, OTRO
  categoria     String?   @db.VarChar(50)
  descripcion   String?
  direccion     String?
  latitud       Decimal   @db.Decimal(10, 6)
  longitud      Decimal   @db.Decimal(10, 6)
  municipio_id  String?   @db.Uuid
  creado_por_id String?   @db.Uuid
  /// Contador de veces que se ha seleccionado este lugar (para ranking futuro)
  veces_usado   Int       @default(0)
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  municipios municipios? @relation(fields: [municipio_id], references: [id], onDelete: SetNull)
  creado_por usuarios?   @relation("custom_places_creado_por", fields: [creado_por_id], references: [id], onDelete: SetNull)

  @@index([nombre], map: "idx_custom_places_nombre")
  @@index([categoria], map: "idx_custom_places_categoria")
  @@index([activo, deleted_at], map: "idx_custom_places_activo")
  @@index([creado_por_id], map: "idx_custom_places_creado_por")
}

/// Anotación libre de un canvas: lo que un usuario escribe en una celda que
/// NO está atada a ningún campo de la base de datos.
///
/// POR QUÉ EXISTE: los canvas son hojas de trabajo COMPARTIDAS. Hasta ahora
/// toda celda sin binding estaba bloqueada por el default-deny de
/// `cell-permission-*`, así que no había forma de dejar una referencia, un
/// recordatorio o un valor de apoyo que vieran los demás. Esto añade esa capa
/// sin ensuciar las tablas de negocio: una anotación NUNCA entra en un total
/// ni en una fórmula, es complemento visual.
///
/// ANCLAJE RELATIVO, no absoluto. Se guarda `offset_fila` (filas por debajo
/// del final del bloque estructurado) y `columna` (absoluta, porque el número
/// de columnas de cada canvas es fijo). Si mañana entran items nuevos, la
/// tabla crece y la anotación baja con ella en vez de quedarse pegada a una
/// fila que ya es otra cosa.
///
/// Tabla dedicada y no un JSONB colgado de cada cabecera: `adicionales` no
/// tiene tabla de cabecera propia, y así los cuatro canvas usan el mismo
/// camino. Además da `version` por celda, que es lo que necesita el
/// compare-and-swap del gateway.
model canvas_anotacion {
  id        String @id @default(uuid()) @db.Uuid
  /// 'cierres-finales' | 'ocasional' | 'adicionales' | 'ingresos'
  scope     String @db.VarChar(40)
  anio      Int
  mes       Int
  /// Hoja dentro del libro. En `cierres-finales` es el id del cierre (una
  /// hoja por placa); en los libros anuales va '' porque el mes ya identifica
  /// la hoja. Cadena vacía y no NULL: en Postgres NULL nunca es igual a NULL,
  /// así que un UNIQUE con NULL dejaría insertar duplicados.
  sheet_key String @default("") @db.VarChar(80)

  /// Cómo se localiza la celda cuando la hoja cambia de forma.
  ///
  /// `fila`: la celda vive en el bloque estructurado o bajo él. `offset_fila`
  ///   cuenta filas desde el final de la tabla de items CON SIGNO, así que toda
  ///   esa zona —descuentos, gastos, impuestos y el área libre— se desplaza en
  ///   bloque cuando entran o salen items, y lo escrito baja con su sección. El
  ///   ancla está por debajo de casi toda la hoja, de modo que la mayoría de
  ///   estas celdas tienen offset NEGATIVO; es lo normal, no un error.
  ///
  /// `item`: la celda vive AL LADO de una fila de item. Se ancla al id de ese
  ///   item (`ancla_ref`), así lo sigue aunque cambie de posición al reordenar
  ///   o al refrescar. Con fila absoluta, la nota acabaría junto a otro item.
  ///
  /// `clave`: la celda es una que el builder declara POR NOMBRE (`ancla_ref`),
  ///   como el % de ADMON de ocasionales. Un parámetro del cálculo que vive en
  ///   la hoja porque no tiene columna propia.
  ///
  /// `top`: la celda vive POR ENCIMA de la tabla de items — la cabecera. Esa
  ///   franja no se mueve, así que aquí `offset_fila` SÍ es la fila absoluta.
  ancla_tipo String @default("fila") @db.VarChar(10)
  /// Id del item (`item`) o nombre declarado por el builder (`clave`). Cadena
  /// vacía en el resto: en Postgres NULL nunca es igual a NULL y rompería el
  /// UNIQUE.
  ancla_ref  String @default("") @db.VarChar(64)

  /// Con `ancla_tipo = 'fila'`, filas respecto al final de la tabla de items,
  /// con signo. Con `'top'`, la fila absoluta. Sin uso en `'item'` y `'clave'`.
  offset_fila Int
  /// Columna absoluta (el ancho de cada canvas es fijo).
  columna     Int

  /// Lo que escribió el usuario. NULL = anotación borrada (se conserva la
  /// fila para no perder el historial de `version`).
  valor  String? @db.Text
  /// Estilo opcional de la celda (resaltado, color de fondo…).
  estilo Json?   @db.JsonB

  /// Compare-and-swap: mismo contrato que el resto de celdas del canvas.
  version Int @default(1)

  creado_por_id      String?  @db.Uuid
  actualizado_por_id String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  creado_por      usuarios? @relation("canvas_anotacion_creado_por", fields: [creado_por_id], references: [id], onDelete: SetNull)
  actualizado_por usuarios? @relation("canvas_anotacion_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: SetNull)

  @@unique([scope, anio, mes, sheet_key, ancla_tipo, ancla_ref, offset_fila, columna], name: "uniq_anotacion_celda")
  @@index([scope, anio, mes])
  @@index([scope, anio, mes, sheet_key])
}

/// ═══════════════════════════════════════════════════════════════════════
/// INGRESOS DE TRANSMERALDA — hojas «OTROS INGRESOS» y «ADICIONALES»
/// ═══════════════════════════════════════════════════════════════════════

/// Cabecera mensual de la liquidación de INGRESOS DE TRANSMERALDA.
///
/// La TABLA de la hoja no se guarda aquí: sus filas son items de
/// `liquidacion_tercero` que dejaron ingreso a la empresa
/// (`ingreso_empresa != 0`) y se leen en vivo, igual que hoy. Lo que sí es
/// dato propio —y por tanto vive en estas tablas— es lo que el equipo decide
/// ENCIMA de esa lista: qué filas bajan a la hoja de ADICIONALES, con qué
/// porcentajes, y los conceptos del pie de cada hoja.
///
/// `@@unique([mes, anio])`: una hoja = una cabecera, igual que en ocasional.
/// De ahí que el autoguardado del canvas pueda ser independiente por mes.
model liquidacion_ingreso_transmeralda {
  id            String  @id @default(uuid()) @db.Uuid
  mes           Int
  anio          Int
  observaciones String? @db.Text

  /// % de administración de la hoja de INGRESOS (ADMON = TOTAL × esto).
  pct_admon_ingresos       Decimal @default(10) @db.Decimal(8, 4)
  /// % con el que el V/UNIDAD de un ingreso baja a la hoja de ADICIONALES.
  /// En el Excel de referencia es el 70 %.
  pct_ganancia_adicionales Decimal @default(70) @db.Decimal(8, 4)
  /// % de administración de la hoja de ADICIONALES.
  pct_admon_adicionales    Decimal @default(10) @db.Decimal(8, 4)

  // ── Totales cacheados ──
  total_facturado_ingresos    Decimal @default(0) @db.Decimal(14, 2)
  total_admon_ingresos        Decimal @default(0) @db.Decimal(14, 2)
  total_liquidar_ingresos     Decimal @default(0) @db.Decimal(14, 2)
  total_facturado_adicionales Decimal @default(0) @db.Decimal(14, 2)
  total_admon_adicionales     Decimal @default(0) @db.Decimal(14, 2)
  total_liquidar_adicionales  Decimal @default(0) @db.Decimal(14, 2)
  /// TRANSPORTE POR PAGAR de la hoja de ADICIONALES. Es exactamente lo que
  /// la hoja de INGRESOS resta como «TOTAL DESCUENTOS LIQUIDACIÓN
  /// ADICIONALES <MES> <AÑO>»: el circuito entre las dos hojas pasa por aquí.
  total_pagar_adicionales     Decimal @default(0) @db.Decimal(14, 2)
  /// Última fila de la hoja de INGRESOS: TOTAL INGRESO TRANSMERALDA.
  total_ingreso_transmeralda  Decimal @default(0) @db.Decimal(14, 2)

  version            Int       @default(1)
  creado_por_id      String?   @db.Uuid
  actualizado_por_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  creado_por      usuarios? @relation("liquidacion_ingreso_transmeralda_creado_por", fields: [creado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actualizado_por usuarios? @relation("liquidacion_ingreso_transmeralda_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  filas     liquidacion_ingreso_transmeralda_fila[]
  conceptos liquidacion_ingreso_transmeralda_concepto[]

  @@unique([mes, anio], name: "uniq_ingreso_transmeralda_periodo")
  @@index([mes, anio])
  @@index([deleted_at])
  @@index([creado_por_id])
  @@index([actualizado_por_id])
}

/// Lo que el equipo decide ENCIMA de un ingreso concreto.
///
/// Solo hay fila para los ingresos que alguien ha tocado —marcarlo para
/// adicionales, cambiarle la cantidad, pisarle un porcentaje—. Un ingreso sin
/// fila se pinta con los valores por defecto de la cabecera, así que la tabla
/// no crece con los cientos de items que nadie ha tocado.
model liquidacion_ingreso_transmeralda_fila {
  id                     String @id @default(uuid()) @db.Uuid
  liquidacion_ingreso_id String @db.Uuid
  /// Item de `liquidacion_tercero` del que sale la fila de la hoja.
  liquidacion_tercero_id String @db.Uuid

  /// `true` ⇒ la fila baja a la hoja de ADICIONALES. Es la columna INCLUIR.
  incluir_adicional Boolean @default(false)
  /// CANT de la hoja de INGRESOS.
  cantidad          Decimal @default(1) @db.Decimal(10, 2)

  /// Overrides opcionales; `null` = hereda el de la cabecera. Se guardan
  /// aparte y no como copia del valor efectivo para que cambiar el % de la
  /// cabecera siga arrastrando a todas las filas que nadie pisó a mano.
  pct_admon_ingresos       Decimal? @db.Decimal(8, 4)
  pct_ganancia             Decimal? @db.Decimal(8, 4)
  pct_admon_adicional      Decimal? @db.Decimal(8, 4)
  /// V/UNIDAD escrito a mano en la hoja de ADICIONALES. Cuando está, manda
  /// sobre el % de ganancia: el Excel de referencia tiene una fila así, y sin
  /// esto habría que retorcer el porcentaje hasta que cuadrara el número.
  valor_unitario_adicional Decimal? @db.Decimal(14, 2)

  orden   Int @default(0)
  version Int @default(1)

  actualizado_por_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  liquidacion_ingreso liquidacion_ingreso_transmeralda @relation(fields: [liquidacion_ingreso_id], references: [id], onDelete: Cascade)
  item                liquidacion_tercero              @relation("liquidacion_ingreso_fila_item", fields: [liquidacion_tercero_id], references: [id], onDelete: Cascade)
  actualizado_por     usuarios?                        @relation("liquidacion_ingreso_fila_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([liquidacion_ingreso_id, liquidacion_tercero_id], name: "uniq_ingreso_fila_item")
  @@index([liquidacion_ingreso_id])
  @@index([liquidacion_tercero_id])
  @@index([incluir_adicional])
  @@index([deleted_at])
}

/// Concepto del PIE de una de las dos hojas.
///
/// Las dos tienen el mismo bloque (personal, gastos de vehículo, anticipos) y
/// se liquidan por separado, así que la hoja forma parte de la identidad del
/// concepto: `hoja` distingue el PAPELERIA de INGRESOS del de ADICIONALES.
model liquidacion_ingreso_transmeralda_concepto {
  id                     String  @id @default(uuid()) @db.Uuid
  liquidacion_ingreso_id String  @db.Uuid
  /// `INGRESOS` | `ADICIONALES`.
  hoja                   String  @db.VarChar(20)
  /// `COSTO_LABORAL` | `GASTO_OPERATIVO` | `ANTICIPO` | `IMPUESTO`.
  ///
  /// Hubo un quinto, `PRESTAMO`, para el bloque «PRESTAMOS Y PAGO HORAS
  /// EXTRAS» del Excel. Este documento no liquida ninguno de los dos —eso
  /// vive en los cierres—, así que eran cuatro filas por hoja que siempre
  /// sumaban cero. El schema no cambia (la columna es VARCHAR sin CHECK):
  /// lo que se retiró es el sembrado en el canvas y el valor del enum de
  /// entrada, y las filas viejas se borran con la migración de datos
  /// `20-08-2026-ingresos-sin-prestamos`.
  tipo                   String  @db.VarChar(50)
  concepto               String  @db.VarChar(100)
  /// Persona del bloque «PERSONAL PARA LA EJECUCIÓN» (el «NOMBRE: …» del
  /// Excel). Agrupa los conceptos laborales; `null` en el resto.
  persona                String? @db.VarChar(150)

  dias           Decimal? @db.Decimal(10, 2)
  valor_unitario Decimal  @default(0) @db.Decimal(14, 2)
  porcentaje     Decimal? @db.Decimal(8, 4)
  valor_total    Decimal  @default(0) @db.Decimal(14, 2)
  base_calculo   Decimal? @db.Decimal(14, 2)
  observaciones  String?  @db.Text
  orden          Int      @default(0)
  version        Int      @default(1)

  actualizado_por_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  liquidacion_ingreso liquidacion_ingreso_transmeralda @relation(fields: [liquidacion_ingreso_id], references: [id], onDelete: Cascade)
  actualizado_por     usuarios?                        @relation("liquidacion_ingreso_concepto_actualizado_por", fields: [actualizado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Nombres explícitos: los que genera Prisma se truncan al mismo string y
  // chocan entre sí (el prefijo del modelo agota el límite de 63 caracteres).
  @@index([liquidacion_ingreso_id], map: "idx_ingreso_concepto_cabecera")
  @@index([liquidacion_ingreso_id, hoja], map: "idx_ingreso_concepto_hoja")
  @@index([tipo], map: "idx_ingreso_concepto_tipo")
  @@index([deleted_at], map: "idx_ingreso_concepto_deleted")
}

// ============================================================================
// FORMULARIOS DINÁMICOS — módulo `formularios-dinamicos`
//
// Motor propio, deliberadamente separado de las tablas legacy de evaluaciones
// (`Evaluacion`/`Pregunta`/`Opcion`/`Resultado`/`Respuesta`): aquellas
// reescriben preguntas y respuestas al editar, y aquí la versión publicada
// tiene que quedar congelada porque un envío firmado la referencia.
//
// Los "enums" son VARCHAR + CHECK en la migración manual y `String` aquí.
// Añadir un valor nuevo es un `ALTER ... DROP/ADD CONSTRAINT` y no un
// `ALTER TYPE`, que en Postgres no se puede revertir dentro de una
// transacción.
//
// Los índices parciales (`WHERE ...`) y los CHECK viven SOLO en
// `prisma/migrations/19-08-2026-formularios-dinamicos/migration.sql`: Prisma
// no sabe expresarlos, y declararlos aquí sin el `WHERE` describiría un
// índice que no es el que existe en la base.
// ============================================================================

/// Identidad estable del formulario. Sobrevive a todas sus versiones: el
/// código HSEQ y el slug no cambian aunque se republique diez veces.
model form_definition {
  id          String  @id @default(uuid()) @db.Uuid
  /// Código documental HSEQ, p. ej. `HSEQ-FR-08`.
  code        String  @unique(map: "uq_form_definitions_code") @db.VarChar(50)
  slug        String  @unique(map: "uq_form_definitions_slug") @db.VarChar(120)
  name        String  @db.VarChar(255)
  description String?
  owner_area  String  @default("hseq") @db.VarChar(80)

  created_by_id String    @db.Uuid
  updated_by_id String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  created_by usuarios       @relation("form_definition_created_by", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updated_by usuarios?      @relation("form_definition_updated_by", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions   form_version[]

  @@map("form_definitions")
}

/// Una revisión completa del formulario. `DRAFT` es lo único editable;
/// publicar la vuelve inmutable y "editar" pasa a ser `clone()`.
///
/// `revision` es el contador de concurrencia optimista del borrador (el
/// autosave del builder lo envía y el servidor responde 409 si no coincide);
/// no tiene relación con `version_number`, que es la línea de versionado
/// funcional visible para HSEQ.
model form_version {
  id             String @id @default(uuid()) @db.Uuid
  form_id        String @db.Uuid
  version_number Int
  /// `DRAFT` | `PUBLISHED` | `ARCHIVED`.
  status         String @default("DRAFT") @db.VarChar(20)
  title          String @db.VarChar(255)

  description          String?
  instructions         String?
  settings_json        Json    @default("{}")
  /// Procedencia documental de la semilla (archivo, revisión, fecha).
  source_metadata_json Json    @default("{}")
  revision             Int     @default(1)

  created_by_id   String    @db.Uuid
  published_by_id String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  published_at    DateTime? @db.Timestamptz(6)
  archived_at     DateTime? @db.Timestamptz(6)

  form         form_definition   @relation(fields: [form_id], references: [id], onDelete: Cascade)
  created_by   usuarios          @relation("form_version_created_by", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  published_by usuarios?         @relation("form_version_published_by", fields: [published_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections     form_section[]
  fields       form_field[]
  assignments  form_assignment[]
  submissions  form_submission[]

  @@unique([form_id, version_number], map: "uq_form_versions_number")
  @@index([form_id, status, version_number(sort: Desc)], map: "idx_form_versions_form_status")
  @@map("form_versions")
}

/// Agrupador visual de campos. `sort_order` es único por versión y la
/// restricción es DEFERRABLE en SQL para que reordenar en una sola
/// transacción no choque a mitad de camino.
model form_section {
  id            String  @id @default(uuid()) @db.Uuid
  version_id    String  @db.Uuid
  key           String  @db.VarChar(120)
  title         String  @db.VarChar(255)
  description   String?
  sort_order    Int
  settings_json Json    @default("{}")

  version form_version @relation(fields: [version_id], references: [id], onDelete: Cascade)
  fields  form_field[]

  @@unique([version_id, key], map: "uq_form_sections_key")
  @@unique([version_id, sort_order], map: "uq_form_sections_order")
  @@index([version_id, sort_order], map: "idx_form_sections_version_order")
  @@map("form_sections")
}

/// Card del constructor. Cada drag crea un `form_field` propio: la paleta
/// define tipos, no registros compartidos, así que editar una card jamás
/// altera otro formulario.
///
/// `parent_field_id` modela `REPEATABLE_GROUP` y `MATRIX`; los hijos son las
/// columnas. Las siete columnas de fecha de los Excel NO se importan como
/// siete campos: cada diligenciamiento es un envío y el historial vive en
/// `form_submissions`.
model form_field {
  id              String  @id @default(uuid()) @db.Uuid
  version_id      String  @db.Uuid
  section_id      String  @db.Uuid
  parent_field_id String? @db.Uuid
  key             String  @db.VarChar(120)
  /// Ver `FIELD_TYPES` en el módulo; el CHECK de la migración es la copia
  /// autoritativa de esa lista.
  type            String  @db.VarChar(40)
  label           String  @db.VarChar(500)

  help_text   String?
  placeholder String? @db.VarChar(500)
  required    Boolean @default(false)
  sort_order  Int

  config_json          Json  @default("{}")
  validation_json      Json  @default("{}")
  /// Regla declarativa (`{version, all/any, effect}`). Nunca JavaScript.
  visibility_rule_json Json?
  default_value_json   Json?

  version  form_version        @relation(fields: [version_id], references: [id], onDelete: Cascade)
  section  form_section        @relation(fields: [section_id], references: [id], onDelete: Cascade)
  parent   form_field?         @relation("form_field_parent", fields: [parent_field_id], references: [id], onDelete: Cascade)
  children form_field[]        @relation("form_field_parent")
  options  form_field_option[]
  answers  form_answer[]

  @@unique([version_id, key], map: "uq_form_fields_key")
  @@unique([section_id, parent_field_id, sort_order], map: "uq_form_fields_order")
  @@index([version_id, section_id, sort_order], map: "idx_form_fields_version_section_order")
  @@map("form_fields")
}

/// Opción de `SINGLE_CHOICE`/`MULTIPLE_CHOICE`. `value` es el token estable
/// que usan las reglas condicionales; `label` es texto que HSEQ puede
/// corregir sin invalidar reglas ni envíos.
model form_field_option {
  id            String   @id @default(uuid()) @db.Uuid
  field_id      String   @db.Uuid
  value         String   @db.VarChar(120)
  label         String   @db.VarChar(255)
  color         String?  @db.VarChar(20)
  score         Decimal? @db.Decimal(12, 2)
  sort_order    Int
  metadata_json Json     @default("{}")

  field   form_field           @relation(fields: [field_id], references: [id], onDelete: Cascade)
  answers form_answer_option[]

  @@unique([field_id, value], map: "uq_form_field_options_value")
  @@unique([field_id, sort_order], map: "uq_form_field_options_order")
  @@map("form_field_options")
}

/// Biblioteca de cards preconfiguradas (C/NC/NA, plan de acción, firma…).
/// Insertar una plantilla COPIA su snapshot: no queda enlazada, así que
/// editar la plantilla no muta formularios ya construidos.
model form_field_template {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(255)
  category      String  @db.VarChar(100)
  field_type    String  @db.VarChar(40)
  template_json Json
  owner_area    String? @db.VarChar(80)
  is_global     Boolean @default(false)

  created_by_id String    @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  created_by usuarios @relation("form_field_template_created_by", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("form_field_templates")
}

/// Quién debe diligenciar qué versión, cuándo y con qué límite.
///
/// Apunta a una versión PUBLICADA exacta, nunca "la última": si HSEQ publica
/// la v3, los envíos en curso siguen contra la v2 que el conductor tiene
/// cacheada, y el historial no cambia de forma retroactiva.
model form_assignment {
  id           String @id @default(uuid()) @db.Uuid
  version_id   String @db.Uuid
  name         String @db.VarChar(255)
  /// `ACTIVE` | `PAUSED` | `CLOSED`.
  status       String @default("ACTIVE") @db.VarChar(20)
  /// `ON_DEMAND` | `ONCE` | `DAILY` | `WEEKLY` | `MONTHLY` | `PER_SERVICE`.
  frequency    String @default("ON_DEMAND") @db.VarChar(30)
  /// `UNLIMITED` | `ONE_PER_PERIOD` | `ONE_PER_CONTEXT`.
  limit_policy String @default("UNLIMITED") @db.VarChar(30)
  /// Zona con la que se calcula `business_date`. El default es la zona de
  /// negocio: con UTC, un preoperacional de las 19:00 en Bogotá contaría
  /// para el día siguiente.
  timezone     String @default("America/Bogota") @db.VarChar(64)

  starts_at DateTime? @db.Timestamptz(6)
  ends_at   DateTime? @db.Timestamptz(6)

  /// Contexto exigido al abrir el runner, p. ej. `{"vehicleId":{"required":true}}`.
  context_schema_json Json @default("{}")
  settings_json       Json @default("{}")

  created_by_id String    @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  version     form_version             @relation(fields: [version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by  usuarios                 @relation("form_assignment_created_by", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets     form_assignment_target[]
  submissions form_submission[]

  @@index([version_id], map: "idx_form_assignments_version")
  @@map("form_assignments")
}

/// Una audiencia de la asignación. El CHECK de la migración obliga a que
/// exactamente la columna del `target_type` esté poblada, para que no exista
/// un target `CONDUCTOR` sin conductor.
model form_assignment_target {
  id            String   @id @default(uuid()) @db.Uuid
  assignment_id String   @db.Uuid
  /// `ALL_CONDUCTORS` | `CONDUCTOR` | `VEHICLE` | `SEDE` | `GROUP`.
  target_type   String   @db.VarChar(30)
  conductor_id  String?  @db.Uuid
  vehicle_id    String?  @db.Uuid
  sede          String?  @db.VarChar(80)
  group_key     String?  @db.VarChar(120)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  assignment form_assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  conductor  conductores?    @relation("form_assignment_target_conductor", fields: [conductor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehiculo   vehiculos?      @relation("form_assignment_target_vehiculo", fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("form_assignment_targets")
}

/// Un diligenciamiento. `SUBMITTED` es terminal: una corrección crea otro
/// envío con `supersedes_submission_id` y se conservan los dos.
///
/// `client_submission_id` lo genera el dispositivo antes de empezar y es
/// UNIQUE: es lo que hace idempotente el POST cuando la red se corta después
/// de que el servidor ya guardó el envío.
model form_submission {
  id                       String  @id @default(uuid()) @db.Uuid
  client_submission_id     String  @unique(map: "uq_form_submissions_client") @db.Uuid
  assignment_id            String  @db.Uuid
  version_id               String  @db.Uuid
  conductor_id             String  @db.Uuid
  vehicle_id               String? @db.Uuid
  service_id               String? @db.Uuid
  supersedes_submission_id String? @db.Uuid
  /// `DRAFT` | `SUBMITTED` | `VOIDED`. `SYNCING`/`FAILED` son estados de la
  /// outbox del dispositivo y no se persisten aquí.
  status                   String  @default("DRAFT") @db.VarChar(20)

  /// Fecha de negocio calculada en servidor con la zona de la asignación.
  business_date DateTime @db.Date
  /// Clave del período para `ONE_PER_PERIOD` (p. ej. `2026-08-19`, `2026-W34`).
  period_key    String?  @db.VarChar(80)
  context_json  Json     @default("{}")
  device_json   Json     @default("{}")

  started_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  submitted_at DateTime? @db.Timestamptz(6)
  voided_at    DateTime? @db.Timestamptz(6)
  voided_by_id String?   @db.Uuid
  void_reason  String?

  assignment  form_assignment         @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version     form_version            @relation(fields: [version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conductor   conductores             @relation("form_submission_conductor", fields: [conductor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehiculo    vehiculos?              @relation("form_submission_vehiculo", fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicio    servicio?               @relation("form_submission_servicio", fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes  form_submission?        @relation("form_submission_supersedes", fields: [supersedes_submission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  superseded  form_submission[]       @relation("form_submission_supersedes")
  voided_by   usuarios?               @relation("form_submission_voided_by", fields: [voided_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers     form_answer[]
  attachments form_attachment[]
  events      form_submission_event[]

  @@index([conductor_id, business_date(sort: Desc), status], map: "idx_form_submissions_portal")
  @@index([version_id, submitted_at(sort: Desc)], map: "idx_form_submissions_version")
  @@map("form_submissions")
}

/// Una respuesta. Los escalares van en la columna tipada que corresponde al
/// tipo del campo (el CHECK de la migración impide poblar dos a la vez) y las
/// opciones seleccionadas se normalizan en `form_answer_options`.
///
/// `occurrence_id` agrupa las celdas de una misma fila de un repetible;
/// `row_index` solo da el orden de presentación. Los índices únicos que
/// impiden respuestas duplicadas son PARCIALES y viven en la migración.
model form_answer {
  id            String  @id @default(uuid()) @db.Uuid
  submission_id String  @db.Uuid
  field_id      String  @db.Uuid
  occurrence_id String? @db.Uuid
  row_index     Int?

  value_text     String?
  value_decimal  Decimal?  @db.Decimal(18, 6)
  value_boolean  Boolean?
  value_date     DateTime? @db.Date
  value_datetime DateTime? @db.Timestamptz(6)
  value_json     Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  submission  form_submission      @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  field       form_field           @relation(fields: [field_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options     form_answer_option[]
  attachments form_attachment[]

  @@index([submission_id], map: "idx_form_answers_submission")
  @@index([field_id], map: "idx_form_answers_field")
  @@map("form_answers")
}

/// Opciones marcadas en una respuesta. Tabla puente y no un array de texto,
/// para que borrar una opción de un borrador falle en vez de dejar envíos
/// apuntando a un token que ya no existe.
model form_answer_option {
  answer_id String @db.Uuid
  option_id String @db.Uuid

  answer form_answer       @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  option form_field_option @relation(fields: [option_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([answer_id, option_id])
  @@map("form_answer_options")
}

/// Evidencia (foto, archivo, firma). El binario vive en S3; aquí solo la
/// metadata y el `sha256` con el que se verifica el objeto subido.
///
/// `client_attachment_id` es UNIQUE por el mismo motivo que
/// `client_submission_id`: reanudar una subida cortada no debe duplicar el
/// adjunto.
model form_attachment {
  id                   String  @id @default(uuid()) @db.Uuid
  submission_id        String  @db.Uuid
  answer_id            String? @db.Uuid
  client_attachment_id String  @unique(map: "uq_form_attachments_client") @db.Uuid
  /// `PHOTO` | `FILE` | `SIGNATURE`.
  kind                 String  @db.VarChar(20)
  /// `PENDING` | `UPLOADED` | `FAILED`.
  status               String  @default("PENDING") @db.VarChar(20)

  object_key    String? @db.VarChar(1024)
  original_name String? @db.VarChar(255)
  mime_type     String  @db.VarChar(150)
  byte_size     BigInt
  sha256        String  @db.VarChar(64)
  metadata_json Json    @default("{}")

  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  uploaded_at DateTime? @db.Timestamptz(6)

  submission form_submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  answer     form_answer?    @relation(fields: [answer_id], references: [id], onDelete: Cascade)

  @@index([submission_id], map: "idx_form_attachments_submission")
  @@map("form_attachments")
}

/// Bitácora append-only del envío: creación, sincronización, aceptación,
/// anulación. Es la única forma de saber quién anuló y por qué, porque
/// `VOIDED` no reabre ni reescribe las respuestas.
model form_submission_event {
  id            String   @id @default(uuid()) @db.Uuid
  submission_id String   @db.Uuid
  event_type    String   @db.VarChar(40)
  /// `CONDUCTOR` | `USER` | `SYSTEM`.
  actor_type    String   @db.VarChar(20)
  /// Sin FK a propósito: apunta a `users` o a `conductores` según
  /// `actor_type`, y es NULL cuando el actor es el sistema.
  actor_id      String?  @db.Uuid
  payload_json  Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  submission form_submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([submission_id, created_at], map: "idx_form_events_submission_time")
  @@map("form_submission_events")
}

/// Snapshot inmutable del estado completo de un cierre final de liquidación
/// de terceros. Se genera en cada cambio relevante y de forma horaria.
/// Permite UNDO y trazabilidad campo a campo con control del usuario.
model liquidacion_tercero_final_snapshot {
  id                           String   @id @default(uuid()) @db.Uuid
  liquidacion_tercero_final_id String   @db.Uuid
  /// Rama lógica. "main" = estado vigente. Cualquier otra rama representa
  /// un snapshot histórico no vigente.
  rama                         String   @default("main") @db.VarChar(60)
  /// Auto-incremental por liquidación. version=1 es la más antigua.
  version                      Int
  /// "manual" (cambio explícito), "auto" (cron horario), "revert"
  /// (al revertir a un snapshot anterior se genera uno nuevo).
  origen                       String   @default("manual") @db.VarChar(20)
  /// Referencia al snapshot desde el que se revirtió (cuando origen=revert).
  revertido_de_id              String?  @db.Uuid
  /// ID del usuario que originó el snapshot. null solo en "auto" del cron.
  usuario_id                   String?  @db.Uuid
  /// Snapshot completo: cabecera + totales + items pivote + conceptos + adicionales.
  payload                      Json     @db.JsonB
  /// Resumen de cambios respecto a la versión anterior.
  diff                         Json?    @db.JsonB
  created_at                   DateTime @default(now()) @db.Timestamptz(6)

  liquidacion_tercero_final liquidacion_tercero_final            @relation(fields: [liquidacion_tercero_final_id], references: [id], onDelete: Cascade)
  usuario                   usuarios?                            @relation("snapshot_usuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  revertido_de              liquidacion_tercero_final_snapshot?  @relation("snapshot_revertido_de", fields: [revertido_de_id], references: [id], onDelete: SetNull)
  revertidos                liquidacion_tercero_final_snapshot[] @relation("snapshot_revertido_de")

  @@unique([liquidacion_tercero_final_id, version])
  @@index([liquidacion_tercero_final_id, rama])
  @@index([created_at])
  @@index([usuario_id])
}

